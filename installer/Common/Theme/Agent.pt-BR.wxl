<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings do instalador do NutManager Agent.

  Mesmo conjunto de Id do Desktop, mais o bloco de dependência que só o Agent possui. A paridade com
  Agent.en-US.wxl é verificada por teste.

  Não são traduzidos: NutManager Agent, NutManagerAgent, Microsoft ASP.NET Core Runtime 10 x64,
  caminhos e versões. Traduzir o nome de um serviço do Windows quebraria a busca por ele.
-->
<WixLocalization Culture="pt-BR" Language="1046" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Instalação do [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="ProductTagline" Value="Serviço seguro para administração remota do NUT" />
  <String Id="ProductKind" Value="Componente de servidor" />
  <String Id="InstallVersion" Value="Versão [WixBundleVersion]" />

  <String Id="InstallIntro" Value="O NutManager Agent será instalado como um serviço do Windows." />
  <String Id="ServiceLabel" Value="Serviço:" />
  <String Id="ServiceValue" Value="NutManagerAgent" />
  <String Id="StartupLabel" Value="Inicialização:" />
  <String Id="StartupValue" Value="Automática" />
  <String Id="NutUntouched" Value="O instalador não instala, configura ou reinicia o serviço NUT." />

  <String Id="DependenciesHeader" Value="Dependências" />
  <String Id="RuntimeName" Value="Microsoft ASP.NET Core Runtime 10 x64" />
  <String Id="RuntimeInstalled" Value="Instalado" />
  <String Id="RuntimeRequired" Value="Necessário" />
  <String Id="RuntimeInstallCheckbox" Value="Instalar o Microsoft ASP.NET Core Runtime 10 x64" />
  <String Id="RuntimeBlockedMessage" Value="O NutManager Agent requer o Microsoft ASP.NET Core Runtime 10 x64. Instale o runtime manualmente ou marque a opção acima para continuar." />

  <String Id="LocationLabel" Value="Local de instalação:" />
  <String Id="LocationValue" Value="C:\Program Files\NutManager Agent" />
  <String Id="TermsHeader" Value="Termos de Uso do NutManager" />
  <String Id="InstallAcceptCheckbox" Value="Li e &amp;aceito os Termos de Uso do NutManager." />
  <String Id="GplNotice" Value="Código-fonte licenciado sob GNU GPL v2.0. Os Termos de Uso não restringem os direitos da GPL." />
  <String Id="InstallInstallButton" Value="&amp;Instalar Agent" />
  <String Id="InstallCancelButton" Value="&amp;Cancelar" />
  <String Id="InstallOptionsButton" Value="&amp;Opções" />

  <String Id="OptionsHeader" Value="Opções de instalação" />
  <String Id="OptionsLocationLabel" Value="Local de instalação:" />
  <String Id="OptionsBrowseButton" Value="&amp;Procurar" />
  <String Id="OptionsOkButton" Value="&amp;OK" />
  <String Id="OptionsCancelButton" Value="&amp;Cancelar" />

  <String Id="ProgressHeader" Value="Instalando NutManager Agent..." />
  <String Id="ProgressLabel" Value="Processando:" />
  <String Id="OverallProgressPackageText" Value="Iniciando..." />
  <String Id="ProgressCancelButton" Value="&amp;Cancelar" />

  <String Id="ModifyHeader" Value="Manutenção do NutManager Agent" />
  <String Id="ModifyRepairButton" Value="&amp;Reparar" />
  <String Id="ModifyUninstallButton" Value="&amp;Desinstalar" />
  <String Id="ModifyCancelButton" Value="&amp;Fechar" />

  <String Id="SuccessHeader" Value="Concluído com sucesso." />
  <String Id="SuccessInstallHeader" Value="NutManager Agent foi instalado com sucesso." />
  <String Id="SuccessRepairHeader" Value="NutManager Agent foi reparado com sucesso." />
  <String Id="SuccessUninstallHeader" Value="NutManager Agent foi removido com sucesso." />
  <String Id="SuccessUnsafeUninstallHeader" Value="NutManager Agent foi removido com sucesso." />
  <String Id="SuccessModifyHeader" Value="Alteração concluída com sucesso." />
  <String Id="SuccessCacheHeader" Value="Download concluído com sucesso." />
  <String Id="SuccessLayoutHeader" Value="Cópia local criada com sucesso." />
  <String Id="SuccessLaunchButton" Value="&amp;Abrir" />
  <String Id="SuccessRestartText" Value="É necessário reiniciar o computador antes de usar o software." />
  <String Id="SuccessUninstallRestartText" Value="É necessário reiniciar o computador para concluir a remoção do software." />
  <String Id="SuccessRestartButton" Value="&amp;Reiniciar" />
  <String Id="SuccessCloseButton" Value="&amp;Fechar" />

  <String Id="FailureHeader" Value="A instalação falhou." />
  <String Id="FailureInstallHeader" Value="Não foi possível instalar o NutManager Agent." />
  <String Id="FailureRepairHeader" Value="Não foi possível reparar o NutManager Agent." />
  <String Id="FailureUninstallHeader" Value="Não foi possível remover o NutManager Agent." />
  <String Id="FailureUnsafeUninstallHeader" Value="Não foi possível remover o NutManager Agent." />
  <String Id="FailureModifyHeader" Value="Não foi possível concluir a alteração." />
  <!-- Uma falha de download é dita como falha de download. Chamá-la de falha do Agent mandaria o
       administrador investigar o servidor errado. -->
  <String Id="FailureCacheHeader" Value="Não foi possível baixar um pacote necessário. Verifique o acesso à internet e execute o instalador novamente." />
  <String Id="FailureLayoutHeader" Value="Não foi possível criar a cópia local." />
  <String Id="FailureHyperlinkLogText" Value="A instalação foi interrompida por um ou mais problemas. Corrija-os e execute o instalador novamente. Para detalhes, consulte o &lt;a href=&quot;#&quot;&gt;arquivo de log&lt;/a&gt;." />
  <String Id="FailureRestartText" Value="É necessário reiniciar o computador para concluir a reversão do software." />
  <String Id="FailureRestartButton" Value="&amp;Reiniciar" />
  <String Id="FailureCloseButton" Value="&amp;Fechar" />

  <!--
    A ajuda descreve o comportamento não assistido, inclusive a variável que desliga o prerequisito.
    Um administrador que use /quiet precisa saber que o runtime é instalado por padrão e como recusar
    isso deliberadamente.
  -->
  <String Id="HelpHeader" Value="Ajuda do instalador" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [pasta] - instala, repara, remove ou cria uma&#xA;   cópia local completa do instalador na pasta indicada. O padrão é /install.&#xA;&#xA;/passive | /quiet - exibe interface mínima sem perguntas, ou nenhuma interface e&#xA;   nenhuma pergunta. Por padrão a interface e as perguntas são exibidas.&#xA;&#xA;/norestart   - suprime tentativas de reinicialização.&#xA;/log log.txt - grava o log no arquivo indicado. Por padrão um log é criado em %TEMP%.&#xA;&#xA;InstallAspNetRuntime=0 - não instalar o Microsoft ASP.NET Core Runtime 10 x64.&#xA;   Se o runtime não estiver presente, a instalação falha antes de registrar o serviço,&#xA;   em vez de deixar um NutManagerAgent que não inicia." />
  <String Id="HelpCloseButton" Value="&amp;Fechar" />

  <String Id="CheckingForUpdatesLabel" Value="Verificando atualizações" />
  <String Id="UpdateButton" Value="&amp;Atualizar para a versão [WixStdBAUpdateAvailable]" />
  <String Id="ConfirmCancelMessage" Value="Deseja mesmo cancelar?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Versão anterior" />

  <String Id="FilesInUseTitle" Value="Arquivos em uso" />
  <String Id="FilesInUseLabel" Value="Os aplicativos a seguir estão usando arquivos que precisam ser atualizados:" />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="Fechar os &amp;aplicativos." />
  <String Id="FilesInUseCloseRadioButton" Value="Fechar os &amp;aplicativos e tentar reabri-los." />
  <String Id="FilesInUseDontCloseRadioButton" Value="&amp;Não fechar os aplicativos. Será necessário reiniciar." />
  <String Id="FilesInUseRetryButton" Value="&amp;Tentar novamente" />
  <String Id="FilesInUseIgnoreButton" Value="&amp;Ignorar" />
  <String Id="FilesInUseExitButton" Value="&amp;Sair" />
</WixLocalization>
