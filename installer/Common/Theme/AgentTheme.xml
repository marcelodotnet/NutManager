<?xml version="1.0" encoding="utf-8"?>
<!--
  The NutManager Agent installer.

  Same design language as the desktop theme and deliberately not the same screen. The Agent is a
  Windows service on a server, not the application with the windows and the charts, and an operator
  who installs it expecting the desktop client has installed the wrong thing on the wrong machine.
  So the subtitle says what it is, a line states the service name and start type, and another states
  plainly that nothing here touches NUT.

  The dependency block is the other difference. The Agent runs framework-dependent, so .NET 10 x64
  and ASP.NET Core 10 x64 are real preconditions rather than recommendations, and this screen has to
  answer three questions honestly for each: is it here, will we install it, and what happens if you
  say no.

  Conditions read four Burn variables. DotNetRuntimeVersion and AspNetCoreRuntimeVersion hold the
  newest installed compatible 10.x runtime of each type and are unset when their runtime is missing.
  InstallDotNetRuntime and InstallAspNetRuntime are the operator's answers, defaulted to yes and only
  ever consulted when the corresponding runtime is missing.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <Font Id="0" Height="-12" Weight="400" Foreground="windowtext" Background="window">Segoe UI</Font>
  <Font Id="1" Height="-26" Weight="600" Foreground="windowtext">Segoe UI</Font>
  <Font Id="2" Height="-14" Weight="400" Foreground="graytext">Segoe UI</Font>
  <Font Id="3" Height="-12" Weight="400" Foreground="windowtext" Background="window">Segoe UI</Font>
  <Font Id="4" Height="-12" Weight="600" Foreground="windowtext">Segoe UI</Font>
  <Font Id="5" Height="-11" Weight="400" Foreground="graytext">Segoe UI</Font>
  <Font Id="6" Height="-12" Weight="600" Foreground="#B34700">Segoe UI</Font>

  <Window Width="620" Height="600" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)">
    <ImageControl X="20" Y="20" Width="88" Height="88" ImageFile="logo.png" Visible="yes" />
    <Label X="124" Y="22" Width="-20" Height="34" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.Title)</Label>
    <Label X="126" Y="58" Width="-20" Height="20" FontId="2" Visible="yes" DisablePrefix="yes">#(loc.ProductTagline)</Label>
    <Label X="126" Y="80" Width="-20" Height="18" FontId="5" Visible="yes" DisablePrefix="yes">#(loc.ProductKind)</Label>
    <Label X="126" Y="98" Width="-20" Height="18" FontId="5" Visible="yes" DisablePrefix="yes">#(loc.InstallVersion)</Label>

    <Page Name="Help">
      <Label X="20" Y="128" Width="-20" Height="30" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
      <Label X="20" Y="160" Width="-20" Height="-70" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
      <Button Name="HelpCloseButton" X="-20" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">
        <Text>#(loc.HelpCloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Loading">
      <Label X="20" Y="128" Width="-20" Height="30" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
    </Page>

    <Page Name="Install">
      <Label X="20" Y="128" Width="-20" Height="18" FontId="3" DisablePrefix="yes">#(loc.InstallIntro)</Label>

      <Label X="20" Y="152" Width="150" Height="16" FontId="5" DisablePrefix="yes">#(loc.ServiceLabel)</Label>
      <Label X="180" Y="152" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.ServiceValue)</Label>
      <Label X="20" Y="170" Width="150" Height="16" FontId="5" DisablePrefix="yes">#(loc.StartupLabel)</Label>
      <Label X="180" Y="170" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.StartupValue)</Label>

      <!-- Stated on the screen, not only in the manual. It is the single most common wrong
           expectation about this installer. -->
      <Label X="20" Y="194" Width="-20" Height="16" FontId="5" DisablePrefix="yes">#(loc.NutUntouched)</Label>

      <Label X="20" Y="222" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.DependenciesHeader)</Label>
      <Label X="20" Y="244" Width="270" Height="16" FontId="3" DisablePrefix="yes">#(loc.DotNetRuntimeName)</Label>

      <Label X="300" Y="244" Width="100" Height="16" FontId="4" DisablePrefix="yes"
             VisibleCondition="DotNetRuntimeVersion &gt;= v10.0.0">#(loc.RuntimeInstalled)</Label>
      <Label X="300" Y="244" Width="100" Height="16" FontId="6" DisablePrefix="yes"
             VisibleCondition="NOT (DotNetRuntimeVersion &gt;= v10.0.0)">#(loc.RuntimeRequired)</Label>
      <Checkbox Name="InstallDotNetRuntime" X="410" Y="240" Width="-20" Height="20" TabStop="yes" FontId="3"
                VisibleCondition="NOT (DotNetRuntimeVersion &gt;= v10.0.0)">#(loc.RuntimeInstallCheckbox)</Checkbox>

      <Label X="20" Y="274" Width="270" Height="16" FontId="3" DisablePrefix="yes">#(loc.AspNetCoreRuntimeName)</Label>
      <Label X="300" Y="274" Width="100" Height="16" FontId="4" DisablePrefix="yes"
             VisibleCondition="AspNetCoreRuntimeVersion &gt;= v10.0.0">#(loc.RuntimeInstalled)</Label>
      <Label X="300" Y="274" Width="100" Height="16" FontId="6" DisablePrefix="yes"
             VisibleCondition="NOT (AspNetCoreRuntimeVersion &gt;= v10.0.0)">#(loc.RuntimeRequired)</Label>
      <Checkbox Name="InstallAspNetRuntime" X="410" Y="270" Width="-20" Height="20" TabStop="yes" FontId="3"
                VisibleCondition="NOT (AspNetCoreRuntimeVersion &gt;= v10.0.0)">#(loc.RuntimeInstallCheckbox)</Checkbox>

      <!-- Declined while missing. The Install action is disabled below; this says why, because a
           greyed-out button with no explanation is indistinguishable from a broken installer. -->
      <Label X="20" Y="304" Width="-20" Height="32" FontId="6" DisablePrefix="yes"
             VisibleCondition="(NOT (DotNetRuntimeVersion &gt;= v10.0.0) AND NOT InstallDotNetRuntime) OR (NOT (AspNetCoreRuntimeVersion &gt;= v10.0.0) AND NOT InstallAspNetRuntime)">#(loc.RuntimeBlockedMessage)</Label>

      <Label X="20" Y="344" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.TermsHeader)</Label>
      <Richedit Name="EulaRichedit" X="20" Y="364" Width="-20" Height="-104" TabStop="yes" FontId="0" HexStyle="800000" />
      <Checkbox Name="EulaAcceptCheckbox" X="20" Y="-78" Width="-20" Height="20" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
      <Label X="20" Y="-54" Width="-20" Height="18" FontId="5" DisablePrefix="yes">#(loc.GplNotice)</Label>

      <!--
        Two independent preconditions, both required.

        The runtime clause is what stops a knowingly broken install: with no runtime and the offer
        declined, this service would register and then fail to start, which is worse than refusing
        because it leaves a broken service behind on a server.

        EulaAcceptCheckbox is restated here on purpose. WixStdBA gates this button on acceptance by
        itself, but a theme EnableCondition is the more specific rule, and a condition that silently
        replaced the acceptance gate would let someone install without accepting the Terms. Naming
        both means the worst case is a redundant clause rather than a missing one.
      -->
      <Button Name="InstallButton" X="-116" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0"
              EnableCondition="(DotNetRuntimeVersion &gt;= v10.0.0 OR InstallDotNetRuntime) AND (AspNetCoreRuntimeVersion &gt;= v10.0.0 OR InstallAspNetRuntime) AND EulaAcceptCheckbox">#(loc.InstallInstallButton)</Button>
      <Button Name="InstallCancelButton" X="-20" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">
        <Text>#(loc.InstallCancelButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Options">
      <Label X="20" Y="130" Width="-20" Height="30" FontId="2" DisablePrefix="yes">#(loc.OptionsHeader)</Label>
      <Label X="20" Y="170" Width="-20" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Label>
      <Editbox Name="InstallFolder" X="20" Y="192" Width="-116" Height="22" TabStop="yes" FontId="3" FileSystemAutoComplete="yes" />
      <Button Name="BrowseButton" X="-20" Y="191" Width="90" Height="26" TabStop="yes" FontId="3">
        <Text>#(loc.OptionsBrowseButton)</Text>
        <BrowseDirectoryAction VariableName="InstallFolder" />
      </Button>
      <Button Name="OptionsOkButton" X="-116" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">
        <Text>#(loc.OptionsOkButton)</Text>
        <ChangePageAction Page="Install" />
      </Button>
      <Button Name="OptionsCancelButton" X="-20" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">
        <Text>#(loc.OptionsCancelButton)</Text>
        <ChangePageAction Page="Install" Cancel="yes" />
      </Button>
    </Page>

    <Page Name="Progress">
      <Label X="20" Y="130" Width="-20" Height="30" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
      <Label X="20" Y="176" Width="90" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
      <!--
        Burn names the package it is currently executing, so when the prerequisite runs the operator
        sees the Microsoft runtime named here rather than a bar that appears to stall on "NutManager
        Agent" for a minute. No invented sub-steps: this is the only progress Burn actually knows.
      -->
      <Label Name="OverallProgressPackageText" X="114" Y="176" Width="-20" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="20" Y="200" Width="-20" Height="16" />
      <Button Name="ProgressCancelButton" X="-20" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
    </Page>

    <Page Name="Modify">
      <Label X="20" Y="130" Width="-20" Height="30" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
      <Button Name="RepairButton" X="-200" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
      <Button Name="UninstallButton" X="-116" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
      <Button Name="ModifyCancelButton" X="-20" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">
        <Text>#(loc.ModifyCancelButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Success">
      <Label X="20" Y="130" Width="-20" Height="30" FontId="2" DisablePrefix="yes">
        <Text>#(loc.SuccessHeader)</Text>
        <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.SuccessUnsafeUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
        <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
        <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
      </Label>
      <Label X="20" Y="-72" Width="-20" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">
        <Text>#(loc.SuccessRestartText)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text>
      </Label>
      <Button Name="SuccessRestartButton" X="-116" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
      <Button Name="SuccessCloseButton" X="-20" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">
        <Text>#(loc.SuccessCloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Failure">
      <Label X="20" Y="130" Width="-20" Height="30" FontId="2" DisablePrefix="yes">
        <Text>#(loc.FailureHeader)</Text>
        <Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.FailureUnsafeUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.FailureCacheHeader)</Text>
        <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
        <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
      </Label>
      <Hypertext Name="FailureLogFileLink" X="20" Y="176" Width="-20" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
      <Hypertext Name="FailureMessageText" X="30" Y="220" Width="-20" Height="80" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
      <Label X="20" Y="-72" Width="-20" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
      <Button Name="FailureRestartButton" X="-116" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
      <Button Name="FailureCloseButton" X="-20" Y="-20" Width="90" Height="26" TabStop="yes" FontId="0">
        <Text>#(loc.FailureCloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>
  </Window>
</Theme>
