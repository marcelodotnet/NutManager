\pard\fi-200\li480\sa40\bullet\tab permiss\u245?es;\par
\pard\fi-200\li480\sa40\bullet\tab certificados;\par
\pard\fi-200\li480\sa40\bullet\tab HTTPS, quando utilizado;\par
\pard\fi-200\li480\sa40\bullet\tab firewall;\par
\pard\fi-200\li480\sa40\bullet\tab pol\u237?ticas do Windows;\par
\pard\fi-200\li480\sa40\bullet\tab credenciais autorizadas.\par
\pard\sb180\sa90\b\fs24 9. Credenciais e seguran\u231?a\b0\fs20\par
