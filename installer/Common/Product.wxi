<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared authoring for both products.

  Version, publisher and the upgrade codes live here so the two installers cannot drift apart on the
  values that decide whether an upgrade is recognised. Version is supplied by the build with -d and
  comes from NutManagerVersion in Directory.Build.props; there is no default, because an installer
  that quietly stamps itself 0.0.0 is worse than one that refuses to build.

  The upgrade codes are fixed forever. Changing one turns every future release into a parallel
  installation instead of an upgrade, leaving two copies registered at once.
-->
<Include>
  <?define Publisher = "Marcelo Pacheco" ?>

  <?define DesktopName = "NutManager" ?>
  <?define DesktopUpgradeCode = "{8E1D4C2A-5F73-4B96-A1D8-2C7E9B04F351}" ?>

  <?define AgentName = "NutManager Agent" ?>
  <?define AgentUpgradeCode = "{C4A97F60-1E38-42D5-8B27-6D0F5A3E9C84}" ?>
  <?define AgentServiceName = "NutManagerAgent" ?>

  <!--
    A bundle carries its own upgrade code, distinct from the package it chains. Sharing one makes the
    bundle and the MSI look like the same product to the engine, and the uninstall of either starts
    removing the other.
  -->
  <?define DesktopBundleUpgradeCode = "{3A7F91C5-6E42-4D08-B57A-9C1E4B026F83}" ?>
  <?define AgentBundleUpgradeCode = "{95E2B738-4A1C-4F69-8D03-7E56C0A9142B}" ?>

  <!--
    Official destinations. The account was renamed from Marcelo-PX to marcelodotnet; GitHub still
    redirects the old name, but a redirect lasts only until someone else claims it, so nothing
    installer-visible points at it any more.
  -->
  <?define ProjectUrl = "https://github.com/marcelodotnet/NutManager" ?>
  <?define SourceLicenseUrl = "https://github.com/marcelodotnet/NutManager/blob/main/LICENSE" ?>

  <!--
    The Agent's runtime prerequisites.

    Detection and installation are deliberately different questions. Detection asks whether any
    serviced .NET 10.x and ASP.NET Core 10.x can run the agent, so a machine already on compatible
    10.x releases is satisfied and nothing is downloaded. Installation, when it is needed, uses exact
    pinned builds - a floating "latest" URL would mean two machines running the same installer on
    different days get different runtimes, and neither could be reproduced from the repository.

    The hash and size below describe that exact file. They come from Microsoft's published checksum
    list for 10.0.11 and from the download's own response headers, not from a local copy.
  -->
  <?define DotNetMajorVersion = "10" ?>
  <?define DotNetRuntimeVersion = "10.0.11" ?>
  <?define DotNetRuntimeFileName = "dotnet-runtime-10.0.11-win-x64.exe" ?>
  <?define DotNetRuntimeDisplayName = "Microsoft .NET Runtime 10 x64" ?>
  <?define DotNetRuntimeUrl = "https://builds.dotnet.microsoft.com/dotnet/Runtime/10.0.11/dotnet-runtime-10.0.11-win-x64.exe" ?>
  <?define DotNetRuntimeSize = "30604768" ?>
  <?define DotNetRuntimeHash = "694e0e0af26b2b8949b8eda8a3831ab31aeac79797d43d6ff8c8798eae642c0904852e641c47329d7d893408f25feab1530ca2b7a0c6ed0d991e0113466a4bf9" ?>

  <?define AspNetCoreMajorVersion = "10" ?>
  <?define AspNetCoreRuntimeVersion = "10.0.11" ?>
  <?define AspNetCoreRuntimeFileName = "aspnetcore-runtime-10.0.11-win-x64.exe" ?>
  <?define AspNetCoreRuntimeDisplayName = "Microsoft ASP.NET Core Runtime 10 x64" ?>
  <?define AspNetCoreRuntimeUrl = "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.11/aspnetcore-runtime-10.0.11-win-x64.exe" ?>
  <?define AspNetCoreRuntimeSize = "11262944" ?>
  <?define AspNetCoreRuntimeHash = "a03584ddf93937619500e9126c83d55afef5dc10ae1eb1d861b581dbaec3656a052fd11c9dd4763cc7a9c6dcfe9987f981d27fbf282afd466a568143d66d319f" ?>
</Include>
