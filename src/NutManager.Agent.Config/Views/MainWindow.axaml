<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:NutManager.Agent.Config.ViewModels"
        xmlns:converters="clr-namespace:NutManager.Agent.Config.Presentation"
        xmlns:localization="clr-namespace:NutManager.Agent.Config.Localization"
        x:Class="NutManager.Agent.Config.Views.MainWindow"
        x:DataType="viewModels:AgentConfigViewModel"
        Title="NutManager Agent Config"
        Width="800"
        Height="600"
        CanResize="False"
        UseLayoutRounding="True"
        Icon="/Assets/Branding/NutManager.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource NutSurface1Brush}">

  <!--
    A compact operations console rather than a second desktop shell. The composition follows the
    operator's scan order: choose transports, complete HTTPS, verify the owned Windows resources,
    then apply. The Operators workflow remains on the same surface because it is part of the Agent
    security boundary, but it is visually subordinate to transport selection.
  -->
  <Window.Resources>
    <DataTemplate x:Key="AgentResourceItemTemplate" x:DataType="viewModels:AgentStatusItemViewModel">
      <Border Classes="agent-resource-item"
              BorderBrush="{DynamicResource NutBorderSubtleBrush}"
              BorderThickness="0,0,1,0"
              ToolTip.Tip="{Binding TooltipText}"
              AutomationProperties.Name="{Binding AccessibleText}">
        <!--
          Two rows, not three columns.

          The state glyph used to sit in a third column at the far right of the cell, which put it as
          far from the words it was judging as the column allowed - a red cross floating beside a
          label it did not appear to belong to. It now leads the state line, directly under the
          title, so the pair reads as one statement.

          The resource glyph still identifies the row and the state glyph still judges it: a padlock
          says which resource, an amber triangle says how it is. Neither replaces the other.
        -->
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="7" RowSpacing="10">
          <!--
            The resource glyph is green always, and that green is identity rather than health: it says
            "this row is about the SSL binding", not "the SSL binding is fine". The verdict is the
            glyph on the line below, which keeps its own semantic colour - so a green padlock over a
            red cross is not a contradiction, it is the subject over its state.
          -->
          <PathIcon Grid.Row="0"
                    Grid.Column="0"
                    Data="{Binding IconKey, Converter={x:Static converters:AgentConfigConverters.IconByKey}}"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource NutHealthyBrush}" />
          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     Classes="nut-body"
                     FontWeight="SemiBold"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource NutTextPrimaryBrush}"
                     Text="{Binding Label}"
                     TextWrapping="Wrap"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis" />
          <PathIcon Grid.Row="1"
                    Grid.Column="0"
                    Width="19"
                    Height="19"
                    VerticalAlignment="Center"
                    Data="{Binding StateIconKey, Converter={x:Static converters:AgentConfigConverters.IconByKey}}"
                    Foreground="{Binding StateClass, Converter={x:Static converters:AgentConfigConverters.StateBrush}}" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Classes="nut-metadata"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Text="{Binding Detail}"
                     IsVisible="{Binding HasDetail}"
                     TextWrapping="Wrap"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!--
      Compact density. The shared control styles set a 38px minimum height, which is right for the
      desktop application and too tall here: at 480 the window has room for roughly five stacked
      fields, and four of them would be padding. Only the height and the internal padding change - the
      brushes, the radii and the focus treatment stay exactly as the product defines them.
    -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <!-- The inner editor keeps the shared padding otherwise, which is what squeezed out a digit. -->
    <Style Selector="NumericUpDown /template/ TextBox">
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="11,6" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- The principal surface belongs directly to the window; only functional regions draw cards. -->
    <Style Selector="Border.agent-main-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.agent-shell-card">
      <Setter Property="Background" Value="{DynamicResource NutElevatedSheenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.agent-transport-row">
      <Setter Property="Padding" Value="2,6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.agent-transport-row.locked CheckBox,
                     Border.agent-transport-row.locked PathIcon,
                     Border.agent-transport-row.locked StackPanel">
      <Setter Property="Opacity" Value="0.58" />
    </Style>
    <Style Selector="Border.agent-transport-status TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.agent-transport-status.healthy TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NutHealthyBrightBrush}" />
    </Style>
    <Style Selector="Border.agent-transport-status.critical TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NutCriticalBrightBrush}" />
    </Style>
    <Style Selector="PathIcon.agent-section-icon">
      <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
      <Setter Property="Width" Value="21" />
      <Setter Property="Height" Value="21" />
    </Style>
    <Style Selector="Border.agent-info-strip">
      <Setter Property="Background" Value="{DynamicResource NutAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button.agent-copy-button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.agent-static-field">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource NutSurface2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.agent-service-action">
      <Setter Property="Transitions">
        <Transitions />
      </Setter>
    </Style>
    <Style Selector="Button.agent-service-action PathIcon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions />
      </Setter>
    </Style>
    <Style Selector="Button.agent-service-action:pointerover PathIcon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- The expanded certificate, held in a quiet inset so it reads as detail rather than as a card. -->
    <Style Selector="Border.agent-detail-panel">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
      <Setter Property="Background" Value="{DynamicResource NutSurface1Brush}" />
    </Style>
    <Style Selector="StackPanel.agent-https-fields:disabled">
      <Setter Property="Opacity" Value="0.56" />
    </Style>
    <Style Selector="ItemsControl.agent-resource-strip:disabled">
      <Setter Property="Opacity" Value="0.58" />
    </Style>
    <!--
      A warning outline rather than a filled danger button. The product's nut-danger fill is reserved
      for the affirmative button inside a confirmation, where the operator has already been told what
      will happen; using it out here would give a card header the visual weight of a final answer.
    -->
    <Style Selector="Button.agent-language-selector">
      <Setter Property="Width" Value="86" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <!--
      A circle, not a rounded rectangle. Width equals height and the radius is far larger than half of
      either, so the shape is a true disc at any scaling rather than a square that has been softened.

      The transition values are the shell theme control, to the millisecond: 0.18s on the brushes for
      hover, 0.34s CubicEaseOut on the glyph transform. They are repeated here rather than linked
      because they live in NutShellStyles, which is the sidebar, the navigation rail and the window
      chrome - none of which this one-screen utility has, and importing all of it to reach two
      transitions would drag the whole shell in behind them.
    -->
    <Style Selector="ListBox.agent-certificate-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="ListBox.agent-certificate-list ListBoxItem">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!--
      The eye answers the pointer, using the desktop application's own icon motion: the same
      RenderTransformOrigin, the same CubicEaseOut, the same 1.14 hover scale its metric-card glyphs
      use. Only the press is new, because the desktop has no icon that is pressed - and it rides the
      same transition, so it introduces no timing of its own.

      The transform is on the glyph, never on the button, so the control keeps its measured size and
      nothing around it moves.
    -->
    <Style Selector="PathIcon.agent-eye-glyph">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.agent-eye-button:pointerover PathIcon.agent-eye-glyph">
      <Setter Property="RenderTransform" Value="scale(1.14)" />
      <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
    </Style>
    <Style Selector="Button.agent-eye-button:pressed PathIcon.agent-eye-glyph">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>

    <!--
      The toast. An elevated surface with a subtle edge, coloured only by its glyph - a box filled
      with saturated green for a clipboard write would shout louder than the thing it is confirming.

      Hidden it is transparent and nudged down a few pixels; shown it settles into place. One
      transition covers both directions at 0.18s, which is inside the range wanted for the entry and
      for the exit, and CubicEaseOut is the easing the rest of the product moves with.
    -->
    <Style Selector="Border.agent-toast">
      <Setter Property="Background" Value="{DynamicResource NutSurface3Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(6px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.agent-toast.visible">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="Border.agent-restart-pending">
      <Setter Property="Background" Value="{DynamicResource NutWarningSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutWarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.agent-settings-button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource NutSurface1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource NutTextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
          <BrushTransition Property="Foreground" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.agent-settings-button /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.agent-settings-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.agent-settings-button:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
    </Style>

    <!--
      The gear takes its motion from NutControlStyles, but scoped to its own button.

      The shared rule is written ":pointerover PathIcon.nut-icon-gear" - an ancestor selector with no
      element in front of it, so it matches the glyph whenever *any* ancestor is under the pointer. In
      the desktop shell the nearest hoverable ancestor is the navigation item, so it behaves. Here the
      gear sits directly in the window chrome, and the window itself is an ancestor: pointing anywhere
      in the application turned the gear.

      The first rule below puts it back at rest for that case; the second re-applies the turn where it
      belongs. The values are still the shared ones - 25 degrees, and the 0:0:0.22 CubicEaseOut
      transition every Button PathIcon already carries - so nothing here invents an animation.

      Short turn toward the setting: never a full revolution, never a loop.
    -->
    <Style Selector="Window:pointerover PathIcon.nut-icon-gear">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.agent-settings-button:pointerover PathIcon.nut-icon-gear">
      <Setter Property="RenderTransform" Value="rotate(25deg)" />
    </Style>

    <!--
      The house does not turn. A cog turns because that is what a cog does; a house doing it would be
      the animation talking about itself. It lifts very slightly instead, on the transition every
      Button PathIcon already carries.
    -->
    <Style Selector="Button.agent-settings-button:pointerover PathIcon.agent-home-glyph">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>

    <!--
      The section strip, as the desktop application draws it in Administration.

      Mirrored from ListBox.nut-section-tabs in NutShellStyles, which is the desktop shell and cannot
      be linked here: same 13,9 padding, same 14 corner radius, the same two-pixel bottom border that
      is transparent until the item is current, and the same pair of brush transitions. A test holds
      these values against that file so the two cannot drift.

      The bottom border belongs to the item, not to the strip: it runs the width of the button it
      marks. Sheen and accent line together, because that is what the desktop does - the sheen alone
      turned each item into a small card, which is what this replaces.

      No Width and no equal columns. Each item is as wide as its own label plus the standard padding.
    -->
    <Style Selector="Button.agent-section-tab">
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource NutTextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.agent-section-tab /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <!--
        Rounded on top, square at the bottom.

        A uniform radius curves a bottom-only border up both sides, and what should read as a line
        under the item reads as an outline around it. Squaring the two bottom corners is what leaves
        the accent as a straight rule along the edge it marks.
      -->
      <Setter Property="CornerRadius" Value="12,12,0,0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.agent-section-tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutGlassRowHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.agent-section-tab.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutSelectedSheenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.agent-section-tab.selected">
      <Setter Property="Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.agent-section-tab.selected PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
    </Style>

    <!--
      A hairline between the items, shorter than they are and centred against them, so it separates
      without drawing a grid. It is the subtle border brush the rest of the window already uses.
    -->
    <Style Selector="Border.agent-section-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource NutBorderSubtleBrush}" />
    </Style>

    <!--
      The segmented light/dark control, as the desktop application draws it.

      Same shape, same sizes, same brushes and the same glyph movement as Border.nut-theme-toggle in
      NutShellStyles: a pill holding two round options, the selected one filled - warm for the sun,
      accent for the moon. Mirrored rather than linked because NutShellStyles is the desktop shell -
      its sidebar, navigation rail and window chrome - and it depends on controls this utility
      deliberately does not have. A test holds these values against that file so the two cannot drift.
    -->
    <Style Selector="Border.agent-theme-toggle">
      <Setter Property="Background" Value="{DynamicResource NutSurface1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.agent-theme-option">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource NutTextMutedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
          <BrushTransition Property="Foreground" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.agent-theme-option /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.agent-theme-option:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.agent-theme-option.selected">
      <Setter Property="Foreground" Value="{DynamicResource NutWarningBrush}" />
    </Style>
    <Style Selector="Button.agent-theme-option.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutWarningSoftBrush}" />
    </Style>
    <Style Selector="Button.agent-theme-option.selected.moon">
      <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
    </Style>
    <Style Selector="Button.agent-theme-option.selected.moon /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutAccentSoftBrush}" />
    </Style>

    <!--
      The glyphs, moving the way the shell moves them. Both take colour from the button so the
      selected state carries through, and both are transitions only, so the control costs nothing
      while nobody is pointing at it. The sun turns an eighth of a turn - the library draws eight
      rays, so a ray lands where a ray was - and the moon leans back as if setting.
    -->
    <Style Selector="Path.agent-theme-glyph">
      <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.agent-theme-option:pointerover Path.agent-sun">
      <Setter Property="RenderTransform" Value="rotate(45deg) scale(1.08)" />
    </Style>
    <Style Selector="Button.agent-theme-option:pointerover Path.agent-moon">
      <Setter Property="RenderTransform" Value="rotate(-18deg) scale(1.06)" />
    </Style>

    <!--
      The switch takes the product accent.

      The startup switch defaults to the Fluent accent, which on this machine renders red - and a red
      switch reads as a fault rather than as a setting that is on. NutManager accent is blue, and it
      is already defined in the linked colour dictionary, so this points the control at it rather
      than introducing a colour.
    -->
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource NutAccentBrush}" />
    </Style>
    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource NutAccentBrightBrush}" />
    </Style>

    <!-- The glyph takes the item colour, so active, inactive and hover carry through to it. -->
    <Style Selector="Button.agent-section-tab PathIcon.agent-tab-icon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <Style Selector="Button.agent-reset-https">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutWarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource NutWarningBrush}" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Button.agent-reset-https /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutWarningBrush}" />
    </Style>
    <Style Selector="Button.agent-reset-https:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutWarningSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutWarningBrush}" />
    </Style>
    <Style Selector="Button.agent-reset-https PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource NutWarningBrush}" />
    </Style>
    <!--
      Registering the service is an ordinary action, not a destructive one, so it takes the window's
      own accent rather than the reset button's warning outline. Same height and padding as that one,
      because they are the two actions in this settings surface and they should read as siblings.
    -->
    <Style Selector="Button.agent-install-service">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource NutAccentBrush}" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Button.agent-install-service /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrush}" />
    </Style>
    <Style Selector="Button.agent-install-service:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrush}" />
    </Style>
    <Style Selector="Button.agent-install-service PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource NutAccentBrush}" />
    </Style>
    <!--
      A disabled action still has to say what it is. Avalonia dims the content on its own; what this
      adds is the muted outline, so the button reads as unavailable rather than as accented-but-inert.
    -->
    <Style Selector="Button.agent-install-service:disabled /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      A switch with no labels should be the width of its knob.

      Fluent lays the knob out beside two content presenters and a fixed separating column, and keeps
      all of it whether or not there is any content - which left a band of empty control between this
      switch and the button that belongs next to it. Collapsing the presenters gives the row back its
      spacing, and it is scoped to this one switch so the theme control in Appearance is untouched.
    -->
    <Style Selector="ToggleSwitch#StartWithWindowsSwitch /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleSwitch#StartWithWindowsSwitch /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--
      The question mark beside a switch that cannot be used.

      The glyph is its own circle, so the button draws none: a border here would put a second ring
      around the first. It sits a little inside the height of the switch beside it - level with it and
      clearly paired, without competing with the control it is only explaining.
    -->
    <Style Selector="Button.agent-help-button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource NutTextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.agent-help-button /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.agent-help-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.agent-help-button:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
    </Style>

    <Style Selector="Border.agent-resource-item">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="TextBox.agent-validation-input.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource NutCriticalBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="NumericUpDown.agent-validation-input.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource NutCriticalBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">
    <!-- ============================================================ operational footer -->
    <Border x:Name="AgentFooter"
            DockPanel.Dock="Bottom"
            Background="{DynamicResource NutHeaderBrush}"
            BorderBrush="{DynamicResource NutBorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,3">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
        <TextBlock Grid.Column="0"
                   Classes="nut-metadata"
                   VerticalAlignment="Center"
                   Text="{Binding ApplicationVersion}" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Ellipse Classes="nut-agent-status-dot"
                   Classes.healthy="{Binding ServiceIsRunning}"
                   Classes.critical="{Binding !ServiceIsInstalled}"
                   VerticalAlignment="Center" />
          <TextBlock Classes="nut-metadata" VerticalAlignment="Center"
                     Text="{Binding ServiceFooterText}" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Classes="nut-metadata"
                   VerticalAlignment="Center"
                   Text="{Binding ServiceMessage}"
                   IsVisible="{Binding ServiceMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextTrimming="CharacterEllipsis" />
        <!--
          The result of an Apply lives here, in the footer, rather than anywhere inside the main card.

          It began beside the buttons, where a long refusal was drawn underneath them. A row of its own
          above the action bar fixed that but took its height out of the cards, which pushed the HTTPS
          card's validation message past its own edge - one overflow traded for another. The footer is
          the one strip whose height nothing else competes for, so the message can appear and disappear
          without a single control above it moving.

          It replaced the logs button, which only led where the Diagnostics button already leads.
        -->
        <Grid Grid.Column="3"
              x:Name="ApplyResultBanner"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="7"
              IsVisible="{Binding HasApplyResult}"
              ToolTip.Tip="{Binding ApplyResultDetail}">
          <PathIcon Grid.Column="0"
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    Data="{Binding ApplyResultKind, Converter={x:Static converters:AgentConfigConverters.ApplyResultIcon}}"
                    Foreground="{Binding ApplyResultKind, Converter={x:Static converters:AgentConfigConverters.ApplyResultBrush}}" />
          <TextBlock Grid.Column="1"
                     Classes="nut-metadata"
                     VerticalAlignment="Center"
                     MaxWidth="420"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding ApplyMessage}"
                     Foreground="{Binding ApplyResultKind, Converter={x:Static converters:AgentConfigConverters.ApplyResultBrush}}" />
        </Grid>
      </Grid>
    </Border>

    <!-- ============================================================ main surface -->
    <Panel Margin="10,5,10,4">
      <Border Classes="agent-main-card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <!-- Header belongs to the principal surface; the native title bar and footer remain outside. -->
          <Grid x:Name="AgentMainHeader"
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                Margin="10,1,10,2">
              <!--
                The mark, and nothing around it.

                It used to sit inside a rounded panel with its own surface and border - a frame drawn
                by this window around an image that already has its own edges. Two competing shapes,
                and the outer one was ours. The size and the spacing are exactly what they were; only
                the container is gone.
              -->
              <Image Grid.Column="0"
                     x:Name="AgentHeaderLogo"
                     Width="78"
                     Height="78"
                     Margin="0,0,13,0"
                     Source="avares://NutManager.Agent.Config/Assets/Branding/NutManager.png"
                     Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="nut-product-title"
                           FontSize="20"
                           Text="{Binding Strings[Window.Title]}" />
                <TextBlock Classes="nut-page-subtitle"
                           FontSize="12"
                           MaxWidth="420"
                           Text="{Binding Strings[Header.Subtitle]}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="7"
                          VerticalAlignment="Center">
                <!--
                  The gear, and nothing beside it.

                  The language selector and the theme button used to sit here, which put two window
                  preferences in the same row as the one control that changes what you are looking at.
                  They are preferences, they belong with the other preferences, and the header is
                  better for having one fewer thing competing with the product name.

                  Circular and icon-only, at the same 36px as the desktop's own round buttons, so the
                  hover and press movement is the movement everything else in this product already has.
                -->
                <Button x:Name="SettingsButton"
                        Classes="agent-settings-button"
                        VerticalAlignment="Center"
                        Command="{Binding HeaderActionCommand}"
                        ToolTip.Tip="{Binding HeaderActionText}"
                        AutomationProperties.Name="{Binding HeaderActionText}">
                  <!--
                    Two glyphs, one visible at a time, rather than one glyph with a swapped geometry.

                    The gear carries the shared nut-icon-gear class and the turn that comes with it;
                    the house must not. Separate elements are what keeps the rotation off the house -
                    a single PathIcon changing its Data would keep the class, and the house would
                    turn like a cog.

                    Same button, same 36px circle, same place in the row: only the glyph and what it
                    means change.
                  -->
                  <Panel Width="19" Height="19">
                    <PathIcon Classes="nut-icon-gear"
                              Data="{DynamicResource NutIconSettings}"
                              Width="19"
                              Height="19"
                              IsVisible="{Binding ShowSettingsAction}" />
                    <PathIcon Classes="agent-home-glyph"
                              Data="{DynamicResource AgentIconHome}"
                              Width="19"
                              Height="19"
                              IsVisible="{Binding ShowHomeAction}" />
                  </Panel>
                </Button>
                <Button VerticalAlignment="Center"
                        Padding="11,6"
                        Command="{Binding ToggleDiagnosticsCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{DynamicResource NutIconDiagnostics}"
                              Width="18"
                              Height="18"
                              Foreground="{DynamicResource NutAccentBrightBrush}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ViewToggleText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
          </Grid>

          <Panel Grid.Row="1">
            <Grid x:Name="ConfigurationSurface"
                  IsVisible="{Binding ShowConfiguration}"
                  RowDefinitions="*,Auto"
                  ColumnDefinitions="0.82*,1.18*"
                  RowSpacing="10"
                  ColumnSpacing="8">

            <!-- ============================================== transport and access -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Classes="agent-shell-card"
                    VerticalAlignment="Stretch">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="agent-section-icon" Data="{DynamicResource NutIconNetwork}" />
                  <TextBlock Classes="nut-card-title"
                             FontSize="15"
                             VerticalAlignment="Center"
                             Text="{Binding Strings[Transport.Title]}" />
                </StackPanel>
                <TextBlock Classes="hint"
                           Text="{Binding Strings[Transport.Description]}"
                           TextWrapping="Wrap" />

                <Border x:Name="NamedPipeTransportRow"
                        Classes="agent-transport-row"
                        Classes.locked="{Binding !CanToggleNamedPipe}"
                        Margin="0,4,0,0">
                  <Grid ColumnDefinitions="Auto,Auto,*,64" ColumnSpacing="6">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding NamedPipeEnabled}"
                              IsEnabled="{Binding CanToggleNamedPipe}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Strings[Transport.NamedPipe]}" />
                    <PathIcon Grid.Column="1"
                              Data="{DynamicResource NutIconSmb}"
                              Width="19"
                              Height="19"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource NutHealthyBrush}" />
                    <StackPanel Grid.Column="2" Spacing="0">
                      <TextBlock Classes="nut-body"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource NutTextPrimaryBrush}"
                                 Text="{Binding Strings[Transport.NamedPipe]}"
                                 TextWrapping="Wrap" />
                      <TextBlock Classes="hint"
                                 Text="{Binding Strings[Transport.NamedPipe.Description]}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="3"
                            Classes="nut-pill agent-transport-status"
                            Classes.healthy="{Binding NamedPipeEnabled}"
                            Classes.critical="{Binding !NamedPipeEnabled}"
                            HorizontalAlignment="Stretch">
                      <TextBlock Classes="nut-metadata"
                                 HorizontalAlignment="Center"
                                 Text="{Binding NamedPipeStatusText}" />
                    </Border>
                  </Grid>
                </Border>

                <Border Classes="nut-divider" Height="1" />

                <Border x:Name="HttpsTransportRow"
                        Classes="agent-transport-row"
                        Classes.locked="{Binding !CanToggleHttps}">
                  <Grid ColumnDefinitions="Auto,Auto,*,64" ColumnSpacing="6">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding HttpsEnabled}"
                              IsEnabled="{Binding CanToggleHttps}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Strings[Transport.Https]}" />
                    <PathIcon Grid.Column="1"
                              Data="{DynamicResource NutIconTls}"
                              Width="19"
                              Height="19"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource NutAccentBrightBrush}" />
                    <StackPanel Grid.Column="2" Spacing="0">
                      <TextBlock Classes="nut-body"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource NutTextPrimaryBrush}"
                                 Text="{Binding Strings[Transport.Https]}"
                                 TextWrapping="Wrap" />
                      <TextBlock Classes="hint"
                                 Text="{Binding Strings[Transport.Https.Description]}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="3"
                            Classes="nut-pill agent-transport-status"
                            Classes.healthy="{Binding HttpsEnabled}"
                            Classes.critical="{Binding !HttpsEnabled}"
                            HorizontalAlignment="Stretch">
                      <TextBlock Classes="nut-metadata"
                                 HorizontalAlignment="Center"
                                 Text="{Binding HttpsStatusText}" />
                    </Border>
                  </Grid>
                </Border>

                <Border Classes="agent-info-strip">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <!--
                      Centred against the whole paragraph rather than pinned to its first line. The
                      grid cell is already as tall as the two lines of text, so Center is the whole
                      change - no offset, no transform.
                    -->
                    <PathIcon Grid.Column="0"
                              Classes="accent"
                              Data="{DynamicResource NutIconInfo}"
                              Width="17"
                              Height="17"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="hint"
                               Text="{Binding LastTransportNotice}"
                               TextWrapping="Wrap" />
                  </Grid>
                </Border>

              </StackPanel>
            </Border>

            <!-- ============================================== HTTPS editor -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    x:Name="HttpsEditorCard"
                    Classes="agent-shell-card"
                    ClipToBounds="True"
                    VerticalAlignment="Stretch">
              <!--
                A DockPanel, not a stack.

                The card is stretched to the row height, and a stack simply overflows it: a two-line
                failure message was drawn past the bottom edge and cut in half, which is the worst
                thing on this card to clip. Docking the message to the bottom reserves its height
                first and lets the fields take what is left, so the explanation is always whole.
              -->
              <DockPanel LastChildFill="True">
                <!--
                  Reset used to sit in this row, and it was the one destructive action on the window
                  placed directly above the fields it destroys. It is in Settings now, where somebody
                  goes deliberately - which is the only way that action should ever be reached.
                -->
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="7"
                      Margin="0,0,0,7">
                  <PathIcon Grid.Column="0"
                            Classes="agent-section-icon"
                            Data="{DynamicResource NutIconTls}" />
                  <TextBlock Grid.Column="1"
                             Classes="nut-card-title"
                             FontSize="15"
                             VerticalAlignment="Center"
                             Text="{Binding Strings[Https.Title]}" />
                </Grid>

                <!--
                  The validation row is docked to the bottom of the card, not left at the end of the
                  field stack.

                  Docked, it is measured and given its height before the fields take what is left, so
                  a two-line message about a host mismatch cannot push itself past the card and into
                  the status card below. Inside the stack it was simply the last thing in a column
                  that had already run out of room. It still collapses to nothing when there is no
                  problem to report.
                -->
                <Grid DockPanel.Dock="Bottom"
                      x:Name="CertificateFeedbackRow"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      Margin="0,6,0,0"
                      IsVisible="{Binding ShowCertificateFeedback}">
                  <PathIcon Grid.Column="0"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Top"
                            Data="{Binding CertificateFeedbackIconKey, Converter={x:Static converters:AgentConfigConverters.IconByKey}}"
                            Foreground="{Binding CertificateFeedbackStateClass, Converter={x:Static converters:AgentConfigConverters.StateBrush}}" />
                  <TextBlock Grid.Column="1"
                             Classes="hint"
                             Text="{Binding CertificateFeedbackMessage}"
                             ToolTip.Tip="{Binding CertificateFeedbackDetail}"
                             TextWrapping="Wrap"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel x:Name="HttpsEditorFields"
                            Classes="agent-https-fields"
                            Spacing="3"
                            VerticalAlignment="Top"
                            IsEnabled="{Binding HttpsEnabled}">
                  <Grid ColumnDefinitions="*,132" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Classes="nut-label" Text="{Binding Strings[Https.Host]}" />
                        <PathIcon Grid.Column="1"
                                  Width="13"
                                  Height="13"
                                  Focusable="True"
                                  IsVisible="{Binding HttpsHostHasError}"
                                  Data="{DynamicResource NutIconError}"
                                  Foreground="{DynamicResource NutCriticalBrush}"
                                  ToolTip.Tip="{Binding HttpsHostValidationMessage}"
                                  AutomationProperties.Name="{Binding HttpsHostValidationMessage}" />
                      </Grid>
                      <TextBox Classes="agent-validation-input"
                               Classes.invalid="{Binding HttpsHostHasError}"
                               Text="{Binding HttpsHost}"
                               ToolTip.Tip="{Binding HttpsHostValidationMessage}"
                               AutomationProperties.Name="{Binding Strings[Https.Host]}"
                               AutomationProperties.HelpText="{Binding HttpsHostValidationMessage}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Classes="nut-label" Text="{Binding Strings[Https.Port]}" />
                        <PathIcon Grid.Column="1"
                                  Width="13"
                                  Height="13"
                                  Focusable="True"
                                  IsVisible="{Binding HttpsPortHasError}"
                                  Data="{DynamicResource NutIconError}"
                                  Foreground="{DynamicResource NutCriticalBrush}"
                                  ToolTip.Tip="{Binding HttpsPortValidationMessage}"
                                  AutomationProperties.Name="{Binding HttpsPortValidationMessage}" />
                      </Grid>
                      <NumericUpDown Classes="agent-validation-input"
                                     Classes.invalid="{Binding HttpsPortHasError}"
                                     Value="{Binding HttpsPort}"
                                     Minimum="1"
                                     Maximum="65535"
                                     Increment="1"
                                     FormatString="0"
                                     ToolTip.Tip="{Binding HttpsPortValidationMessage}"
                                     AutomationProperties.Name="{Binding Strings[Https.Port]}"
                                     AutomationProperties.HelpText="{Binding HttpsPortValidationMessage}" />
                    </StackPanel>
                  </Grid>
                  <!--
                    Label beside the value, like the thumbprint below it. The endpoint is derived from
                    the two fields directly above, so it never needed a heading on a line of its own -
                    and that line is what the certificate validation row now uses.
                  -->
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Classes="nut-label"
                               VerticalAlignment="Center"
                               Text="{Binding Strings[Https.Endpoint]}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding HttpsEndpoint}"
                             IsReadOnly="True"
                             AutomationProperties.Name="{Binding Strings[Https.Endpoint]}" />
                    <Button Grid.Column="2"
                            x:Name="CopyEndpointButton"
                            Classes="agent-copy-button"
                            Tag="{Binding HttpsEndpoint}"
                            Click="OnCopyValueClicked"
                            AutomationProperties.Name="{Binding Strings[Https.Copy]}"
                            ToolTip.Tip="{Binding Strings[Https.Copy]}">
                      <PathIcon Data="{DynamicResource NutIconCopy}" Width="16" Height="16" />
                    </Button>
                    <!--
                      Action confirmation belongs to the action that caused it. Popup keeps it out of
                      measurement, and right-edge alignment lets the compact surface grow leftward
                      while remaining inside the fixed window.
                    -->
                    <Popup x:Name="EndpointCopyPopup"
                           IsOpen="{Binding IsToastPopupOpen}"
                           PlacementTarget="{Binding #CopyEndpointButton}"
                           Placement="BottomEdgeAlignedRight"
                           VerticalOffset="5"
                           IsLightDismissEnabled="False"
                           IsHitTestVisible="False"
                           Focusable="False">
                      <Border x:Name="CopyToast"
                              Classes="agent-toast"
                              Classes.visible="{Binding IsToastVisible}"
                              IsHitTestVisible="False"
                              Focusable="False"
                              AutomationProperties.LiveSetting="Polite"
                              AutomationProperties.Name="{Binding ToastMessage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Data="{Binding ToastKind, Converter={x:Static converters:AgentConfigConverters.ToastIcon}}"
                                    Foreground="{Binding ToastKind, Converter={x:Static converters:AgentConfigConverters.ToastBrush}}" />
                          <TextBlock Classes="nut-body"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource NutTextPrimaryBrush}"
                                     Text="{Binding ToastMessage}" />
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                  <StackPanel Spacing="1">
                    <TextBlock Classes="nut-label" Text="{Binding Strings[Https.Certificate]}" />
                    <!--
                      The summary takes the width and the actions sit under it.

                      All four on one row left the summary about a third of the card, which was not
                      enough for the three lines that identify a certificate - name, issuer, expiry -
                      and clipped even the empty-state sentence. Three buttons only got narrower as
                      they were added, so the row they share is their own.
                    -->
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                      <!--
                        A readonly surface, and nothing more.

                        This was a ComboBox once, and clicking it dropped a list of every certificate
                        in the machine store over the card. Focusable="False" keeps it out of keyboard
                        interaction while hit testing remains available only for its explanatory
                        tooltip. The two certificate actions remain the separate buttons beside it.
                      -->
                      <Border Grid.Row="0"
                              Classes="agent-static-field"
                              Focusable="False"
                              ToolTip.Tip="{Binding Strings[Https.Certificate.Readonly]}"
                              AutomationProperties.Name="{Binding Strings[Https.Certificate]}">
                        <Grid>
                          <TextBlock Classes="nut-metadata"
                                     VerticalAlignment="Center"
                                     Text="{Binding Strings[Https.Certificate.None]}"
                                     IsVisible="{Binding !HasSelectedCertificate}" />
                          <ContentControl Content="{Binding SelectedCertificate}"
                                          IsVisible="{Binding HasSelectedCertificate}">
                            <ContentControl.ContentTemplate>
                              <DataTemplate x:DataType="viewModels:AgentCertificateOption">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                  <PathIcon Grid.Column="0"
                                            Data="{DynamicResource NutIconCertificate}"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource NutHealthyBrush}" />
                                  <!--
                                    Two lines, not three. Giving the actions a row of their own cost
                                    the card a line, and the thumbprint underneath was the thing that
                                    got clipped. Issuer and expiry are both short and both qualify the
                                    same name, so they share a line rather than one of them going
                                    away - the full detail is a click away on the eye, and every field
                                    is spelled out in the selection panel.
                                  -->
                                  <StackPanel Grid.Column="1" Spacing="0">
                                    <TextBlock Classes="nut-body"
                                               Foreground="{DynamicResource NutTextPrimaryBrush}"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="nut-metadata"
                                               Text="{Binding SummaryLine}"
                                               TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ContentControl.ContentTemplate>
                          </ContentControl>
                        </Grid>
                      </Border>
                      <!--
                        Selecting and importing are different operations and stay different buttons.

                        A certificate already in the machine store needs choosing, not importing:
                        making the operator find the original PFX again to point at something Windows
                        already holds would also leave a duplicate behind. This one only reads.
                      -->
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                      <Button Command="{Binding OpenCertificateSelectionCommand}"
                              ToolTip.Tip="{Binding Strings[Https.Select.Tooltip]}"
                              AutomationProperties.Name="{Binding Strings[Https.Select.Tooltip]}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <PathIcon Data="{DynamicResource NutIconCertificate}" Width="16" Height="16" />
                          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Https.Select]}" />
                        </StackPanel>
                      </Button>
                      <!--
                        Inline rather than the Windows certificate dialog: X509Certificate2UI never came
                        to .NET, and the four facts that decide whether HTTPS will work are the four
                        this panel shows. Sending an operator to certlm.msc to read them would be
                        sending them away from the screen that refused the certificate.
                      -->
                      <Button Click="OnImportCertificateClicked"
                              IsEnabled="{Binding CanImportCertificate}"
                              ToolTip.Tip="{Binding Strings[Https.Import]}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <PathIcon Data="{DynamicResource AgentIconImport}" Width="16" Height="16" />
                          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Https.Import]}" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="ViewCertificateButton"
                              Classes="nut-ghost agent-eye-button"
                              Command="{Binding ToggleCertificateDetailsCommand}"
                              IsEnabled="{Binding SelectedCertificate, Converter={x:Static ObjectConverters.IsNotNull}}"
                              ToolTip.Tip="{Binding Strings[Https.Certificate.ViewTooltip]}"
                              AutomationProperties.Name="{Binding Strings[Https.Certificate.ViewTooltip]}">
                        <PathIcon Classes="agent-eye-glyph"
                                  Data="{DynamicResource AgentIconEye}"
                                  Width="17"
                                  Height="17" />
                      </Button>
                      </StackPanel>
                    </Grid>

                  </StackPanel>
                  <!--
                    Collapsed with nothing to show. A label over an empty value is dead space in a card
                    that has none to spare, and it reads as a thumbprint that could not be loaded.
                  -->
                  <!--
                    Label and value on one line.

                    Stacked, this block cost two lines the card no longer has: the actions took a row
                    of their own so the summary could be read, and the thumbprint was what fell off
                    the bottom. A forty-character hex string does not need a line to itself, and
                    putting the label beside it is what makes both fit above the validation row.
                  -->
                  <Grid x:Name="ThumbprintField"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="8"
                        IsVisible="{Binding ShowThumbprint}">
                    <TextBlock Grid.Column="0"
                               Classes="nut-label"
                               VerticalAlignment="Center"
                               Text="{Binding Strings[Https.Thumbprint]}" />
                    <TextBlock Grid.Column="1"
                               Classes="nut-code"
                               VerticalAlignment="Center"
                               Text="{Binding CertificateThumbprint}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{Binding Strings[Https.Thumbprint]}" />
                  </Grid>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- ============================================== owned Windows resources -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    x:Name="ResourceStatusCard"
                    Classes="agent-shell-card"
                    Padding="10,10">
              <StackPanel Spacing="9">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <PathIcon Classes="agent-section-icon" Data="{DynamicResource NutIconShield}" />
                  <TextBlock Classes="nut-card-title"
                             FontSize="15"
                             VerticalAlignment="Center"
                             Text="{Binding Strings[Resources.Title]}" />
                </StackPanel>
                <!--
                  The strip is an ItemsControl over a UniformGrid, and the MinHeight is not decoration.

                  Avalonia's UniformGrid measures to zero height in this arrangement: the panel asks for
                  no vertical space, so the card draws its title and nothing else while all four items
                  sit in the collection. Binding four ContentControls to ResourceStatus[0..3] instead
                  produced the same empty strip, so the index route is no better. This minimum is what
                  actually reserves the row, and it is sized for the worst case this template can
                  produce - a label wrapping to two lines above a one-line detail - so a longer pt-BR or
                  en-US string still fits rather than being clipped.
                -->
                <ItemsControl Classes="agent-resource-strip"
                              ItemsSource="{Binding ResourceStatus}"
                              MinHeight="64"
                              IsEnabled="{Binding HttpsEnabled}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="AgentResourceItemTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ================================================ diagnostics -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding ShowDiagnostics}">
          <Border Classes="agent-shell-card"
                  Padding="14"
                  VerticalAlignment="Top">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Classes="agent-section-icon" Data="{DynamicResource NutIconDiagnostics}" />
                <TextBlock Classes="nut-card-title"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Text="{Binding Strings[Diagnostics.Title]}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Diagnostics}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="viewModels:AgentStatusItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          Margin="0,5,22,5"
                          AutomationProperties.Name="{Binding AccessibleText}">
                      <TextBlock Grid.Column="0"
                                 Classes="nut-body"
                                 VerticalAlignment="Top"
                                 Text="{Binding Glyph}"
                                 Foreground="{Binding StateClass, Converter={x:Static converters:AgentConfigConverters.StateBrush}}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="nut-body"
                                   Foreground="{DynamicResource NutTextPrimaryBrush}"
                                   Text="{Binding Label}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="nut-metadata"
                                   Text="{Binding Detail}"
                                   IsVisible="{Binding HasDetail}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 Classes="nut-metadata"
                                 VerticalAlignment="Top"
                                 Text="{Binding StatusText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </Border>
          </ScrollViewer>

          <!-- ================================================ terms -->
          <Grid IsVisible="{Binding ShowTerms}" RowDefinitions="Auto,*" RowSpacing="10">
            <!--
              Back and title, the way an inner page carries them: the control that leaves is the
              first thing in the reading order, and the title names where you are rather than
              repeating where you came from.
            -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
              <Button x:Name="TermsBack"
                      Classes="agent-settings-button"
                      Command="{Binding CloseTermsCommand}"
                      ToolTip.Tip="{Binding Strings[Terms.Back]}"
                      AutomationProperties.Name="{Binding Strings[Terms.Back]}">
                <PathIcon Data="{DynamicResource NutIconChevronLeft}" Width="17" Height="17" />
              </Button>
              <TextBlock Classes="nut-card-title"
                         FontSize="17"
                         VerticalAlignment="Center"
                         Text="{Binding Strings[Terms.Title]}" />
            </StackPanel>

            <!--
              The scroll lives here and nowhere else.

              Three hundred lines of terms will not fit a fixed 800x600 window, and the window does
              not resize. Scrolling this page rather than the shell keeps every other surface laid
              out exactly as it was.
            -->
            <Border Grid.Row="1" Classes="agent-shell-card" Padding="16">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TermsBlocks}" Margin="0,0,10,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="localization:AgentTermsBlock">
                      <Panel>
                        <TextBlock Classes="nut-card-title"
                                   FontSize="16"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="{Binding Text}"
                                   IsVisible="{Binding Kind, Converter={x:Static converters:AgentConfigConverters.IsTermsTitle}}" />
                        <TextBlock Classes="nut-card-title"
                                   FontSize="14"
                                   Margin="0,12,0,4"
                                   TextWrapping="Wrap"
                                   Text="{Binding Text}"
                                   IsVisible="{Binding Kind, Converter={x:Static converters:AgentConfigConverters.IsTermsHeading}}" />
                        <TextBlock Classes="hint"
                                   Margin="0,0,0,6"
                                   TextWrapping="Wrap"
                                   Text="{Binding Text}"
                                   IsVisible="{Binding Kind, Converter={x:Static converters:AgentConfigConverters.IsTermsParagraph}}" />
                        <Grid ColumnDefinitions="Auto,*"
                              Margin="10,0,0,5"
                              IsVisible="{Binding Kind, Converter={x:Static converters:AgentConfigConverters.IsTermsBullet}}">
                          <TextBlock Grid.Column="0"
                                     Classes="hint"
                                     Margin="0,0,7,0"
                                     Text="&#x2022;" />
                          <TextBlock Grid.Column="1"
                                     Classes="hint"
                                     TextWrapping="Wrap"
                                     Text="{Binding Text}" />
                        </Grid>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- ================================================ settings -->
          <!--
            No scrollbar on a settings page.

            About was a few pixels too tall and grew one, which put a scrollbar down the side of a
            card that is otherwise all whitespace. The window is a fixed 800x600 and these four panels
            are meant to fit it, so the fix is for the content to fit rather than for the page to
            scroll. The terms are the one thing here that genuinely cannot fit, and they have a page
            and a scrollbar of their own.
          -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled"
                        IsVisible="{Binding ShowSettings}">
            <Border Classes="agent-shell-card" Padding="14" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Classes="agent-section-icon" Data="{DynamicResource NutIconSettings}" />
                  <TextBlock Classes="nut-card-title"
                             FontSize="17"
                             VerticalAlignment="Center"
                             Text="{Binding Strings[Settings.Title]}" />
                </StackPanel>

                <!--
                  Four destinations, in the order somebody needs them: what the agent does at boot,
                  how this window looks, what the machine currently reports, and what this build is.

                  Buttons and dividers rather than a TabControl. The desktop draws this pattern in
                  Administration as a row of items sharing one surface, each marked when current by an
                  accent line along its own bottom edge - and a TabControl generates its own strip,
                  which leaves nowhere to put a divider. The values below are that pattern: 13,9
                  padding, the sheen and the accent bottom border together, the hover row brush.

                  Each item is as wide as its own label. Four equal columns would make "Geral" carry
                  the width of "Aparência" for no reason other than symmetry.
                -->
                <StackPanel x:Name="SettingsTabs" Orientation="Horizontal" Spacing="0">
                  <Button Classes="agent-section-tab"
                          Classes.selected="{Binding IsGeneralTab}"
                          Command="{Binding SelectGeneralTabCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <PathIcon Classes="agent-tab-icon" Data="{DynamicResource AgentIconTabGeneral}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Settings.Tab.General]}" />
                    </StackPanel>
                  </Button>
                  <Border Classes="agent-section-divider" />
                  <Button Classes="agent-section-tab"
                          Classes.selected="{Binding IsUsersTab}"
                          Command="{Binding SelectUsersTabCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <PathIcon Classes="agent-tab-icon" Data="{DynamicResource AgentIconTabUsers}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Settings.Tab.Users]}" />
                    </StackPanel>
                  </Button>
                  <Border Classes="agent-section-divider" />
                  <Button Classes="agent-section-tab"
                          Classes.selected="{Binding IsAgentTab}"
                          Command="{Binding SelectAgentTabCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <PathIcon Classes="agent-tab-icon" Data="{DynamicResource NutIconService}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Settings.Tab.Agent]}" />
                    </StackPanel>
                  </Button>
                  <Border Classes="agent-section-divider" />
                  <Button Classes="agent-section-tab"
                          Classes.selected="{Binding IsAboutTab}"
                          Command="{Binding SelectAboutTabCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <PathIcon Classes="agent-tab-icon" Data="{DynamicResource NutIconInfo}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Settings.Tab.About]}" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                  <!-- ================================================================ general -->

                    <StackPanel Spacing="16" Margin="2,14,2,2"
                                IsVisible="{Binding IsGeneralTab}">
                      <!--
                        Heading, then the control, then what it does.

                        The switch used to sit on the far right of the heading row, which put the one
                        thing you act on as far from the words explaining it as the card allowed. It
                        reads top to bottom now: what this is, the control, the consequence.
                      -->
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="StartupHeading"
                                   Classes="nut-card-title"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Text="{Binding Strings[Settings.Startup.Title]}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                          <!--
                            The tooltip lives on the wrapper rather than the switch, because a disabled
                            control takes no pointer input and the reason it is disabled is exactly what
                            somebody would hover to read.
                          -->
                          <Border Background="Transparent"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding StartupBlockedReason}"
                                  AutomationProperties.HelpText="{Binding StartupBlockedReason}">
                            <ToggleSwitch x:Name="StartWithWindowsSwitch"
                                          IsChecked="{Binding StartsWithWindows, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChangeStartup}"
                                          OnContent=""
                                          OffContent=""
                                          AutomationProperties.Name="{Binding Strings[Settings.Startup.Title]}" />
                          </Border>
                          <!--
                            Present only while the switch cannot be used, and it goes to the one place
                            that can change that. A disabled control that explains itself is better than
                            one that does not; a disabled control that offers the remedy is better still.
                          -->
                          <Button x:Name="StartupInstallHelp"
                                  Classes="agent-help-button"
                                  Margin="-14,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ShowStartupHelp}"
                                  Command="{Binding ShowServiceInstallationCommand}"
                                  ToolTip.Tip="{Binding Strings[Settings.Startup.Install]}"
                                  AutomationProperties.Name="{Binding Strings[Settings.Startup.Install]}">
                            <PathIcon Data="{DynamicResource AgentIconHelp}" Width="14" Height="14" />
                          </Button>
                        </StackPanel>
                        <TextBlock Classes="hint"
                                   TextWrapping="Wrap"
                                   Text="{Binding Strings[Settings.Startup.Description]}" />
                        <!--
                          The result of an action, and only ever that. It carries a disc rather than a
                          bare sentence so the outcome is legible before the words are read, and it is
                          emphasised because it is the one line on the panel that just changed.
                        -->
                        <StackPanel x:Name="StartupResult"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    Margin="0,2,0,0"
                                    IsVisible="{Binding HasStartupResult}">
                          <PathIcon Width="15"
                                    Height="15"
                                    VerticalAlignment="Center"
                                    Data="{Binding StartupResultKind, Converter={x:Static converters:AgentConfigConverters.SettingsFeedbackIcon}}"
                                    Foreground="{Binding StartupResultKind, Converter={x:Static converters:AgentConfigConverters.SettingsFeedbackBrush}}" />
                          <TextBlock Classes="nut-metadata"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap"
                                     Text="{Binding StartupResultText}" />
                        </StackPanel>
                      </StackPanel>

                      <Border Classes="nut-divider" Height="1" />

                      <!--
                        Appearance and language, on one row.

                        They were a tab of their own, which gave two window preferences the same weight
                        in the navigation as the machine and the agent. They are preferences, they
                        belong with the other one, and side by side they take a fraction of the room
                        they used to: each is a label over its control, and the two labels line up.
                      -->
                      <StackPanel Spacing="8">
                        <TextBlock Classes="nut-card-title"
                                   FontSize="14"
                                   Text="{Binding Strings[Settings.Appearance.Section]}" />
                        <!--
                          Two halves, each a label over its control, and both labels on the same line.

                          The theme keeps the control it has always had: the segmented pill, the
                          sentence naming where pressing it goes, and the line underneath saying what
                          it affects. Folding these two preferences onto one row was meant to save
                          height, and it briefly cost the pill its words - which left two glyphs to
                          carry the whole meaning, with no way to tell "you are here" from "go here"
                          without pressing one and watching.

                          The language column is sized to its own control and pushed to the right
                          edge rather than given half the card. Two equal halves put the ComboBox on
                          the centre line, which reads as a second field in a sequence rather than as
                          the other side of a row - and left the theme description wrapping early with
                          empty space beside it. The theme takes the room it needs; the language keeps
                          the width it has, at the far side.
                        -->
                        <Grid x:Name="AppearanceAndLanguage"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="28">
                          <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Top">
                            <TextBlock Classes="nut-label"
                                       Text="{Binding Strings[Settings.Appearance.Theme]}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                              <Border x:Name="ThemeToggle" Classes="agent-theme-toggle">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                  <Button Classes="agent-theme-option"
                                          Classes.selected="{Binding ShowDarkThemeAction}"
                                          Command="{Binding SelectLightThemeCommand}"
                                          ToolTip.Tip="{Binding Strings[Settings.Appearance.Theme.Light]}"
                                          AutomationProperties.Name="{Binding Strings[Settings.Appearance.Theme.Light]}">
                                    <Grid Width="18" Height="18">
                                      <Viewbox Width="18" Height="18">
                                        <Grid Width="24" Height="24">
                                          <Path Classes="agent-theme-glyph agent-sun"
                                                Stretch="None"
                                                Data="{DynamicResource NutIconSun}" />
                                        </Grid>
                                      </Viewbox>
                                    </Grid>
                                  </Button>
                                  <Button Classes="agent-theme-option moon"
                                          Classes.selected="{Binding ShowLightThemeAction}"
                                          Command="{Binding SelectDarkThemeCommand}"
                                          ToolTip.Tip="{Binding Strings[Settings.Appearance.Theme.Dark]}"
                                          AutomationProperties.Name="{Binding Strings[Settings.Appearance.Theme.Dark]}">
                                    <Grid Width="18" Height="18">
                                      <Viewbox Width="18" Height="18">
                                        <Grid Width="24" Height="24">
                                          <Path Classes="agent-theme-glyph agent-moon"
                                                Stretch="None"
                                                Data="{DynamicResource NutIconMoon}" />
                                        </Grid>
                                      </Viewbox>
                                    </Grid>
                                  </Button>
                                </StackPanel>
                              </Border>
                              <TextBlock x:Name="ThemeActionLabel"
                                         VerticalAlignment="Center"
                                         Classes="hint"
                                         Text="{Binding ThemeActionText}" />
                            </StackPanel>
                            <TextBlock x:Name="ThemeDescription"
                                       Classes="hint"
                                       TextWrapping="Wrap"
                                       Text="{Binding Strings[Settings.Appearance.Theme.Description]}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Top">
                            <TextBlock Classes="nut-label"
                                       Text="{Binding Strings[Settings.Appearance.Language]}" />
                            <ComboBox x:Name="LanguageSelector"
                                      VerticalAlignment="Center"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding Strings[Language.Label]}"
                                      AutomationProperties.Name="{Binding Strings[Language.Label]}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate DataType="viewModels:AgentLanguageOption">
                                  <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </StackPanel>

                  <!-- ================================================================ users -->

                    <!--
                      Who may administer the agent, as the panel itself.

                      It used to be a page behind a button on the Agent panel, which put a summary and
                      a way in where the list could simply have been. Choosing who holds administrative
                      rights over the service is what this destination is for, so it is what the
                      destination shows.

                      Every rule behind it already existed and is reused rather than restated: the
                      group is located, listed, added to and removed from by the same administration
                      boundary the diagnostics view has always used, with its domain-controller
                      confirmation intact. What changed is where an operator finds it.
                    -->
                    <StackPanel x:Name="UsersPanel" Spacing="10" Margin="2,14,2,2"
                                IsVisible="{Binding IsUsersTab}">
                      <TextBlock Classes="hint"
                                 TextWrapping="Wrap"
                                 Text="{Binding Strings[Settings.Permissions.Intro]}" />
                      <TextBlock Classes="nut-metadata"
                                 TextWrapping="Wrap"
                                 Text="{Binding OperatorsGroupCaption}" />

                      <Border Classes="nut-divider" Height="1" />

                      <!--
                        The group has to exist before anyone can be added to it, and it is created by
                        installing the agent rather than by opening this panel. Saying where it comes
                        from beats a button here that would create a Windows group as a side effect of
                        looking at one.
                      -->
                      <StackPanel x:Name="PermissionsGroupMissing"
                                  Orientation="Horizontal"
                                  Spacing="7"
                                  IsVisible="{Binding !OperatorsGroupExists}">
                        <PathIcon Width="15"
                                  Height="15"
                                  VerticalAlignment="Center"
                                  Data="{DynamicResource AgentIconFeedbackWarning}"
                                  Foreground="{DynamicResource NutWarningBrush}" />
                        <TextBlock Classes="nut-metadata"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding Strings[Settings.Permissions.GroupMissing]}" />
                      </StackPanel>

                      <StackPanel Spacing="8" IsVisible="{Binding OperatorsGroupExists}">
                        <TextBlock Classes="nut-card-title"
                                   FontSize="14"
                                   Text="{Binding Strings[Settings.Permissions.Members]}" />

                        <TextBlock x:Name="PermissionsEmpty"
                                   Classes="hint"
                                   IsVisible="{Binding !HasMembers}"
                                   Text="{Binding Strings[Settings.Permissions.Empty]}" />

                        <!--
                          The list scrolls, the window does not. A machine with thirty authorized
                          accounts must not be able to push the button that adds the thirty-first off
                          the bottom of a window that cannot be resized.
                        -->
                        <ScrollViewer x:Name="PermissionsMemberList"
                                      MaxHeight="150"
                                      IsVisible="{Binding HasMembers}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding Members}" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <!--
                                  The account, and the one thing that may be done to it. The button
                                  carries the account as its parameter rather than relying on a
                                  selection, so the row that was clicked is the row that is acted on.
                                -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" Margin="0,3">
                                  <PathIcon Grid.Column="0"
                                            Data="{DynamicResource NutIconUsers}"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource NutTextSecondaryBrush}" />
                                  <TextBlock Grid.Column="1"
                                             Classes="nut-metadata"
                                             VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"
                                             Text="{Binding}" />
                                  <Button Grid.Column="2"
                                          x:Name="PermissionsRemoveMember"
                                          Classes="agent-reset-https"
                                          Padding="9,3"
                                          VerticalAlignment="Center"
                                          Command="{Binding $parent[ItemsControl].DataContext.RemoveOperatorCommand}"
                                          CommandParameter="{Binding}"
                                          Content="{Binding $parent[ItemsControl].DataContext.RemoveMemberText}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>

                        <!--
                          Choosing an account, then adding it. Two steps rather than one, because a
                          box that grants administrative rights the moment it is filled in is one
                          keystroke away from granting them to the wrong account.

                          The field is the existing one and resolves the account through the same
                          identity boundary as before, so a name Windows cannot resolve is refused
                          rather than stored. What this does not yet do is open the Windows account
                          picker: that needs interop this round did not take on, and it is recorded as
                          a limitation rather than replaced with something improvised.
                        -->
                        <Button x:Name="PermissionsSelectUser"
                                Classes="agent-install-service"
                                Padding="10,5"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding !IsAddingOperator}"
                                Command="{Binding BeginAddOperatorCommand}"
                                AutomationProperties.Name="{Binding Strings[Settings.Permissions.Select]}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource NutIconUsers}" Width="14" Height="14" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Strings[Settings.Permissions.Select]}" />
                          </StackPanel>
                        </Button>

                        <StackPanel x:Name="PermissionsAddPanel"
                                    Spacing="7"
                                    IsVisible="{Binding IsAddingOperator}">
                          <TextBlock Classes="nut-label" Text="{Binding Strings[Operators.AddUser]}" />
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     x:Name="PermissionsAccount"
                                     Text="{Binding NewMemberAccount}"
                                     PlaceholderText="{Binding Strings[Operators.Placeholder]}"
                                     AutomationProperties.Name="{Binding Strings[Operators.AddUser]}" />
                            <Button Grid.Column="1"
                                    Classes="agent-install-service"
                                    Padding="10,5"
                                    Command="{Binding AddMemberCommand}"
                                    Content="{Binding Strings[Operators.Add]}" />
                            <Button Grid.Column="2"
                                    Padding="10,5"
                                    Command="{Binding CancelAddOperatorCommand}"
                                    Content="{Binding Strings[Action.Cancel]}" />
                          </Grid>
                        </StackPanel>
                      </StackPanel>

                      <TextBlock Classes="nut-metadata"
                                 TextWrapping="Wrap"
                                 Text="{Binding OperatorsMessage}"
                                 IsVisible="{Binding OperatorsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                  <!-- ================================================================ agent -->

                    <!--
                      What the machine reports, then what can be done about it.

                      One surface, two sections, a rule between them - the same shape General has. The
                      state comes first because it is what somebody arriving here is checking, and the
                      installation follows because it is the answer when that state says the service
                      is not there at all. It is also where the help button beside a disabled startup
                      switch sends them, so the remedy has to be on the panel it points at.
                    -->
                    <StackPanel Spacing="10" Margin="2,14,2,2"
                                IsVisible="{Binding IsAgentTab}">
                      <TextBlock Classes="nut-card-title"
                                 FontSize="14"
                                 Text="{Binding Strings[Settings.Agent.Section]}" />
                      <Grid ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="7"
                            ColumnSpacing="16">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[Settings.Agent.Service]}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="nut-metadata"
                                   TextWrapping="Wrap" Text="{Binding ServiceStateText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[Settings.Agent.StartMode]}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="nut-metadata"
                                   TextWrapping="Wrap" Text="{Binding ServiceStartTypeText}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[Settings.Agent.Account]}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="nut-metadata"
                                   TextWrapping="Wrap" Text="{Binding ServiceAccountText}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[Settings.Agent.Transports]}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="nut-metadata"
                                   TextWrapping="Wrap" Text="{Binding ActiveTransportsText}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[Settings.Agent.HttpsPort]}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="nut-metadata"
                                   TextWrapping="Wrap" Text="{Binding HttpsPortText}" />
                      </Grid>

                      <Border Classes="nut-divider" Height="1" />

                      <StackPanel Spacing="6">
                        <TextBlock Classes="nut-card-title"
                                   FontSize="14"
                                   Text="{Binding Strings[Settings.Agent.Install.Title]}" />
                        <!--
                          Whether the machine has the agent, said with a disc and in emphasis. Not an
                          error when it does not: a machine that has not had the agent installed yet is
                          a normal machine, and this is the section that offers to change that.
                        -->
                        <StackPanel x:Name="AgentInstallState"
                                    Orientation="Horizontal"
                                    Spacing="7">
                          <PathIcon Width="15"
                                    Height="15"
                                    VerticalAlignment="Center"
                                    Data="{Binding ServiceInstallState, Converter={x:Static converters:AgentConfigConverters.SettingsFeedbackIcon}}"
                                    Foreground="{Binding ServiceInstallState, Converter={x:Static converters:AgentConfigConverters.SettingsFeedbackBrush}}" />
                          <TextBlock Classes="nut-metadata"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap"
                                     Text="{Binding ServiceInstallDescription}" />
                        </StackPanel>
                        <!--
                          One action in one place, through the whole lifecycle.

                          Install, Installing, Remove, Removing are four labels on the same spot rather
                          than controls that move: the action area does not shift under the pointer,
                          and an operation in progress is reported where it started. Which one it is
                          comes from the service control manager, never from what was last clicked - so
                          nothing here claims a registration the SCM has not confirmed. Two buttons in
                          one Panel rather than one button that changes colour, because installing and
                          removing are not the same kind of act and should not look like it.
                        -->
                        <Panel HorizontalAlignment="Left" Margin="0,10,0,0">
                          <Button x:Name="AgentInstallService"
                                  Classes="agent-install-service"
                                  Padding="10,5"
                                  IsVisible="{Binding !ServiceActionIsRemoval}"
                                  Command="{Binding InstallServiceCommand}"
                                  AutomationProperties.Name="{Binding ServiceActionText}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Data="{DynamicResource NutIconService}" Width="14" Height="14" />
                              <TextBlock VerticalAlignment="Center" Text="{Binding ServiceActionText}" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="AgentRemoveService"
                                  Classes="agent-reset-https"
                                  Padding="10,5"
                                  IsVisible="{Binding ServiceActionIsRemoval}"
                                  Command="{Binding RemoveServiceCommand}"
                                  AutomationProperties.Name="{Binding ServiceActionText}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Data="{DynamicResource AgentIconProhibit}" Width="14" Height="14" />
                              <TextBlock VerticalAlignment="Center" Text="{Binding ServiceActionText}" />
                            </StackPanel>
                          </Button>
                        </Panel>
                        <StackPanel x:Name="AgentInstallResult"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    Margin="0,2,0,0"
                                    IsVisible="{Binding HasInstallResult}">
                          <PathIcon Width="15"
                                    Height="15"
                                    VerticalAlignment="Center"
                                    Data="{Binding InstallResultKind, Converter={x:Static converters:AgentConfigConverters.SettingsFeedbackIcon}}"
                                    Foreground="{Binding InstallResultKind, Converter={x:Static converters:AgentConfigConverters.SettingsFeedbackBrush}}" />
                          <TextBlock Classes="nut-metadata"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap"
                                     Text="{Binding InstallResultText}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                  <!-- ================================================================ about -->

                    <StackPanel Spacing="7" Margin="2,10,2,2"
                                IsVisible="{Binding IsAboutTab}">
                      <!-- What this is, before what it is made of. No mark: the window already wears it. -->
                      <TextBlock Classes="nut-card-title"
                                 FontSize="15"
                                 Text="{Binding Strings[About.Product]}" />
                      <Grid ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="5"
                            ColumnSpacing="16">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[About.Version]}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="nut-metadata"
                                   Text="{Binding AboutVersion}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[About.Build]}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="nut-metadata"
                                   TextWrapping="Wrap" Text="{Binding AboutBuild}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[About.DotNet]}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="nut-metadata"
                                   Text="{Binding AboutDotNetRuntime}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[About.AspNetCore]}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="nut-metadata"
                                   Text="{Binding AboutAspNetCoreRuntime}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="nut-metadata"
                                   Text="{Binding Strings[About.Developer]}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="nut-metadata"
                                   Text="{Binding AboutDeveloper}" />
                      </Grid>

                      <Border Classes="nut-divider" Height="1" />

                      <!--
                        The address is the link.

                        There was a separate "Open the project page" button under the address, which
                        made two controls out of one idea: the thing you read and the thing you press.
                        The address itself is now the affordance, in the desktop application own
                        nut-link style - a textual link that must not read as a filled button.

                        It still takes no URL. The launcher behind it has one address compiled into
                        it and no parameter to pass another, so what is displayed and what opens are
                        the same constant.
                      -->
                      <StackPanel Spacing="4">
                        <TextBlock Classes="nut-metadata" Text="{Binding Strings[About.ProjectPage]}" />
                        <Button x:Name="ProjectPageLink"
                                Classes="nut-link"
                                HorizontalAlignment="Left"
                                Padding="0,2"
                                Command="{Binding OpenProjectPageCommand}"
                                IsEnabled="{Binding CanOpenProjectPage}"
                                Content="{Binding AboutProjectPageUrl}"
                                ToolTip.Tip="{Binding Strings[About.ProjectPage.Open]}"
                                AutomationProperties.Name="{Binding Strings[About.ProjectPage.Open]}" />
                        <TextBlock Classes="nut-metadata"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource NutCriticalBrush}"
                                   IsVisible="{Binding ProjectPageFailed}"
                                   Text="{Binding Strings[About.ProjectPage.Failed]}" />
                      </StackPanel>

                      <Border Classes="nut-divider" Height="1" />

                      <!--
                        A pointer to the terms, not the terms.

                        The full text used to sit here in a paragraph, which meant About ended in a
                        wall of legal prose nobody scrolled through while the terms themselves were
                        never actually shown. They have their own page now; this says what is there.
                      -->
                      <StackPanel Spacing="4">
                        <TextBlock Classes="nut-metadata" Text="{Binding Strings[About.Terms]}" />
                        <TextBlock Classes="hint"
                                   TextWrapping="Wrap"
                                   Text="{Binding Strings[About.Terms.Description]}" />
                        <Button x:Name="ViewTerms"
                                Classes="nut-ghost"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenTermsCommand}"
                                Content="{Binding Strings[About.Terms.View]}" />
                      </StackPanel>
                    </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
          </Panel>

          <!-- ============================================== actions within the main card -->
          <Border Grid.Row="2"
                  x:Name="ContextualActions"
                  BorderBrush="{DynamicResource NutBorderSubtleBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Grid>
                  <Button x:Name="StartServiceAction"
                          Classes="nut-success agent-service-action"
                          MinWidth="126"
                          Command="{Binding StartServiceCommand}"
                          IsEnabled="{Binding CanStartService}"
                          IsVisible="{Binding ShowStartServiceAction}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{DynamicResource NutIconStart}" Width="17" Height="17" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Service.Start]}" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="StopServiceAction"
                          Classes="nut-danger-solid agent-service-action"
                          MinWidth="126"
                          Command="{Binding StopServiceCommand}"
                          IsEnabled="{Binding CanStopService}"
                          IsVisible="{Binding ShowStopServiceAction}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{DynamicResource NutIconStop}" Width="17" Height="17" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Service.Stop]}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Button x:Name="RestartServiceAction"
                        Classes="agent-service-action"
                        MinWidth="136"
                        Command="{Binding RestartServiceCommand}"
                        IsEnabled="{Binding CanRestartService}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{DynamicResource NutIconRestart}"
                              Width="17"
                              Height="17" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Service.Restart]}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <!--
                Trimmed, not just wrapped.

                Wrapping alone is not enough here: the messages most worth reading are failures, and a
                failure names a file - "...\ProgramData\NutManager\Agent\agent.json is denied" - which
                is one unbreakable token. With nowhere to wrap, the text drew straight over the Apply
                and Cancel buttons. Trimming keeps it inside its column, and the tooltip keeps the
                whole message one hover away.
              -->
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <!--
                  A marker, not a sentence.

                  "Configuration saved. The changes will only take effect after restarting the
                  NutManagerAgent." is true and it is also the whole strip between the service actions
                  and Apply, which left both crowded. The dot and three words say the same thing at a
                  glance; the sentence is on the tooltip for whoever has not met it before.

                  It reports the state and does nothing about it: restarting stays the explicit
                  action on the left.
                -->
                <Border Classes="agent-restart-pending"
                        IsVisible="{Binding RestartRequired}"
                        ToolTip.Tip="{Binding Strings[Service.RestartPending.Detail]}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource NutWarningBrush}" />
                    <TextBlock Classes="nut-metadata"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource NutWarningBrush}"
                               Text="{Binding Strings[Service.RestartPending]}" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <!--
                Apply and Cancel belong to the configuration draft, so they are shown where a draft
                exists. Settings applies each change as it is made, and the terms are a document; a
                Save button beside either would promise something is waiting to be saved.

                The service actions to the left stay put on every surface. They are not part of the
                draft - they act on the running service - and hiding them here would take away the
                one control an operator reaches for after changing the start type.
              -->
              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="6"
                          IsVisible="{Binding ShowActionBar}">
                <!--
                  The tooltip lives on the wrapper, not on the button.

                  A disabled control in Avalonia takes no pointer input, so a ToolTip attached to Apply
                  itself would never appear in exactly the state where somebody needs to read it. This
                  Border stays enabled and hit-testable and carries both the tooltip and the accessible
                  help text; the button inside is still genuinely disabled, so nothing can be saved by
                  hovering. The alternative - enabling the button to make the tooltip work and refusing
                  the click afterwards - would make Apply lie about what it does.
                -->
                <Border x:Name="ApplyReasonHost"
                        Background="Transparent"
                        ToolTip.Tip="{Binding ApplyDisabledReason}"
                        AutomationProperties.HelpText="{Binding ApplyDisabledReason}">
                  <Button Classes="nut-primary"
                          Width="116"
                          Height="34"
                          Command="{Binding ApplyCommand}"
                          IsEnabled="{Binding CanApply}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{DynamicResource NutIconApply}" Width="16" Height="16" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Action.Apply]}" />
                    </StackPanel>
                  </Button>
                </Border>
                <Button Width="116"
                        Height="34"
                        Command="{Binding CancelCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{DynamicResource NutIconClose}" Width="16" Height="16" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Action.Cancel]}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ================================================ read-only certificate details -->
      <Border Background="{DynamicResource NutOverlayScrimBrush}"
              IsVisible="{Binding ShowCertificateDetails}">
        <Border Classes="nut-card-elevated"
                Width="620"
                MaxHeight="430"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9">
              <PathIcon Data="{DynamicResource NutIconCertificate}"
                        Width="18"
                        Height="18"
                        Foreground="{DynamicResource NutHealthyBrush}" />
              <TextBlock Classes="nut-card-title"
                         FontSize="17"
                         VerticalAlignment="Center"
                         Text="{Binding Strings[Https.Certificate.Details]}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <Border Classes="agent-detail-panel">
                <Grid ColumnDefinitions="165,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="7">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.Subject]}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificateSubject}" TextWrapping="NoWrap" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.Issuer]}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificateIssuer}" TextWrapping="NoWrap" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.NotBefore]}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificateNotBefore}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.NotAfter]}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificateNotAfter}" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Thumbprint]}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Classes="nut-code hint"
                             Text="{Binding CertificateThumbprint}" TextWrapping="NoWrap" />

                  <TextBlock Grid.Row="5" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.Sans]}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificateSubjectAlternativeNames}" TextWrapping="NoWrap" />

                  <TextBlock Grid.Row="6" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.PrivateKey]}" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificatePrivateKeyText}" />

                  <TextBlock Grid.Row="7" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.ServerAuth]}" />
                  <TextBlock Grid.Row="7" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificateServerAuthenticationText}" />

                  <TextBlock Grid.Row="8" Grid.Column="0" Classes="nut-label"
                             Text="{Binding Strings[Https.Certificate.HostMatch]}" />
                  <TextBlock Grid.Row="8" Grid.Column="1" Classes="hint"
                             Text="{Binding CertificateHostMatchText}" />
                </Grid>
              </Border>
            </ScrollViewer>
            <Button Grid.Row="2"
                    HorizontalAlignment="Right"
                    Command="{Binding ToggleCertificateDetailsCommand}"
                    Content="{Binding Strings[Action.Close]}" />
          </Grid>
        </Border>
      </Border>

      <!--
        ================================================ installed certificate selection

        An overlay inside this window rather than a second Window, which is how every other
        confirmation here already works, and never certlm.msc: sending an administrator to a separate
        management console to answer a question this screen asked is how the answer gets lost on the
        way back. The list scrolls; the window does not.
      -->
      <Border Background="{DynamicResource NutOverlayScrimBrush}" IsVisible="{Binding IsSelectingCertificate}">
        <Border Classes="nut-card-elevated"
                Width="620"
                MaxHeight="500"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Data="{DynamicResource NutIconCertificate}"
                          Width="18"
                          Height="18"
                          Foreground="{DynamicResource NutAccentBrightBrush}" />
                <TextBlock Classes="nut-card-title"
                           VerticalAlignment="Center"
                           Text="{Binding Strings[Https.Select.Title]}" />
              </StackPanel>
              <TextBlock Classes="hint" Text="{Binding Strings[Https.Select.Subtitle]}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
              <Button Classes="nut-primary"
                      Width="116"
                      Height="34"
                      Command="{Binding ConfirmCertificateSelectionCommand}"
                      IsEnabled="{Binding CanConfirmCertificateSelection}"
                      Content="{Binding Strings[Https.Select.Confirm]}" />
              <Button Width="116"
                      Height="34"
                      Command="{Binding CancelCertificateSelectionCommand}"
                      Content="{Binding Strings[Action.Cancel]}" />
            </StackPanel>

            <!-- The chosen row, spelled out. Two certificates can share a name and an issuer, so the
                 full thumbprint is here rather than only the abbreviation in the list. -->
            <Border DockPanel.Dock="Bottom"
                    Classes="agent-static-field"
                    Margin="0,10,0,0"
                    Padding="11,8"
                    IsVisible="{Binding PendingCertificate, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="nut-label"
                           Text="{Binding Strings[Https.Certificate.Subject]}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="nut-metadata"
                           Text="{Binding PendingCertificate.Subject}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="nut-label"
                           Text="{Binding Strings[Https.Certificate.Issuer]}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="nut-metadata"
                           Text="{Binding PendingCertificate.Issuer}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="nut-label"
                           Text="{Binding Strings[Https.Thumbprint]}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="nut-code"
                           Text="{Binding PendingCertificate.Thumbprint}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="nut-label"
                           Text="{Binding Strings[Https.Certificate.HostMatch]}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="nut-metadata"
                           Text="{Binding PendingCertificate.HostMatchText}" />
              </Grid>
            </Border>

            <TextBlock Classes="hint"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !HasCertificateCandidates}"
                       Text="{Binding Strings[Https.Select.Empty]}" />

            <ListBox x:Name="CertificateCandidateList"
                     Classes="agent-certificate-list"
                     ItemsSource="{Binding CertificateCandidates}"
                     SelectedItem="{Binding PendingCertificate}"
                     IsVisible="{Binding HasCertificateCandidates}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:AgentCertificateCandidate">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="9"
                        ToolTip.Tip="{Binding Thumbprint}"
                        AutomationProperties.Name="{Binding AccessibleText}">
                    <!-- Usable or not, said in a glyph as well as in words: colour is never the only
                         signal, and the list is never filtered by it. -->
                    <PathIcon Grid.Column="0"
                              Width="18"
                              Height="18"
                              VerticalAlignment="Center"
                              Data="{Binding IsUsable, Converter={x:Static converters:AgentConfigConverters.CandidateIcon}}"
                              Foreground="{Binding IsUsable, Converter={x:Static converters:AgentConfigConverters.CandidateBrush}}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Classes="nut-body"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource NutTextPrimaryBrush}"
                                 Text="{Binding DisplayName}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="nut-metadata" Text="{Binding IssuerLine}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="nut-metadata"
                                 Text="{Binding SummaryText}"
                                 Foreground="{Binding IsUsable, Converter={x:Static converters:AgentConfigConverters.CandidateBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right">
                      <TextBlock Classes="nut-code" FontSize="11" Text="{Binding ShortThumbprint}" />
                      <TextBlock Classes="nut-metadata" TextAlignment="Right" Text="{Binding ValidityLine}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Border>

      <!-- ================================================ confirmation overlay -->
      <Border Background="{DynamicResource NutOverlayScrimBrush}" IsVisible="{Binding IsConfirming}">
        <Border Classes="nut-card-elevated"
                MaxWidth="520"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="warning"
                        Data="{DynamicResource NutIconWarning}"
                        Width="18"
                        Height="18" />
              <TextBlock Classes="nut-card-title"
                         VerticalAlignment="Center"
                         Text="{Binding ConfirmationTitle}" />
            </StackPanel>
            <TextBlock Classes="nut-body"
                       TextWrapping="Wrap"
                       Text="{Binding ConfirmationMessage}" />
            <StackPanel Spacing="6" IsVisible="{Binding IsDisablingHttps}">
              <CheckBox IsChecked="{Binding CleanupFirewallRule}"
                        Content="{Binding Strings[Cleanup.Firewall]}" />
              <CheckBox IsChecked="{Binding CleanupSslBinding}"
                        Content="{Binding Strings[Cleanup.SslBinding]}" />
              <CheckBox IsChecked="{Binding CleanupUrlReservation}"
                        Content="{Binding Strings[Cleanup.UrlReservation]}" />
              <TextBlock Classes="hint"
                         Margin="0,4,0,0"
                         Text="{Binding Strings[Cleanup.CertificateNever]}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="nut-danger"
                      Command="{Binding ConfirmCommand}"
                      Content="{Binding ConfirmButtonText}" />
              <Button Command="{Binding DisableWithoutRemovingCommand}"
                      Content="{Binding Strings[Cleanup.DisableOnly]}"
                      IsVisible="{Binding IsDisablingHttps}" />
              <Button Command="{Binding CancelConfirmationCommand}"
                      Content="{Binding Strings[Action.Cancel]}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Panel>
  </DockPanel>
</Window>
