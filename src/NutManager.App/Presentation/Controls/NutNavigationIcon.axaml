<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
             x:Class="NutManager.App.Presentation.Controls.NutNavigationIcon"
             x:Name="Root"
             Width="24"
             Height="24"
             ClipToBounds="False">
  <!--
    One glyph per navigation destination, drawn by the icon library.

    Each kind used to be several shapes stacked in this box so that one piece could move while the
    rest held still: two LEDs blinking out of phase, a hub sitting motionless inside a turning gear,
    a reading travelling along a pulse trace. The library gives one silhouette per name, so the
    motion moved up a level — the glyph itself carries it now, and the Grid around it still supplies
    the family's hover transform, which is why the two are still separate elements.

    Path rather than PathIcon, so the glyph stays clear of the generic "Button PathIcon" opacity
    rules, whose hover transition would run against the compositor animations below on the same
    property.

    Each glyph is normalised into a 20x20 box rather than drawn at its native coordinates. The
    library's icons do not all occupy the 24 grid equally — their native dimensions vary noticeably
    on their longest side, a 22% spread — so drawing them unscaled made Administration and the cog
    read as oversized while the diagnostics trace, only 14 units tall, read as small. The cog also
    starts at x=2.27 where its neighbours start at x=3.00, which pushed it toward the selection bar.
    Uniform scaling into a fixed box equalises the longest side and centres the ink, so nothing is
    off-axis and every glyph keeps 2 units of clearance inside the 24 slot. 20 is the live area
    Material itself specifies for a 24 grid.

    The Panel carries the name, not the Path: it is exactly 20x20 whatever the glyph's aspect ratio
    turns out to be, so the compositor's centre point is genuinely the centre of what turns.
  -->
  <!--
    The viewport is 32 px while the layout footprint remains 24 px through the symmetric negative
    margin. A 20 px square needs 28.3 px at the cog's 45-degree point, and the other glyphs can
    scale to almost 24 px when their compositor motion and hover transform overlap. Keeping that
    ink inside a 32 px viewport prevents clipping without shrinking the drawings, widening a row,
    or moving its label.
  -->
  <Grid Width="32" Height="32" Margin="-4" ClipToBounds="False">

    <!-- Overview: the dashboard breathes, the way a surface with live figures on it would. -->
    <Grid Classes="nut-icon-motion nut-icon-lift" IsVisible="{Binding IsOverview, ElementName=Root}">
      <Panel x:Name="OverviewGlyph" Classes="nut-nav-slot">
        <shapes:Path Classes="nut-nav-glyph" Data="{DynamicResource NutIconOverview}" />
      </Panel>
    </Grid>

    <!-- Devices: a slow rise and fall in place of the two rack lights that used to blink. -->
    <Grid Classes="nut-icon-motion nut-icon-nudge" IsVisible="{Binding IsDevices, ElementName=Root}">
      <Panel x:Name="DevicesGlyph" Classes="nut-nav-slot">
        <shapes:Path Classes="nut-nav-glyph" Data="{DynamicResource NutIconDevices}" />
      </Panel>
    </Grid>

    <!-- Administration: one pop on arrival, which is what the verified badge used to do. -->
    <Grid Classes="nut-icon-motion nut-icon-lift" IsVisible="{Binding IsAdministration, ElementName=Root}">
      <Panel x:Name="AdministrationGlyph" Classes="nut-nav-slot">
        <shapes:Path Classes="nut-nav-glyph" Data="{DynamicResource NutIconAdministration}" />
      </Panel>
    </Grid>

    <!-- Diagnostics: the trace beats, rather than a dot running along it. -->
    <Grid Classes="nut-icon-motion nut-icon-lift" IsVisible="{Binding IsDiagnostics, ElementName=Root}">
      <Panel x:Name="DiagnosticsGlyph" Classes="nut-nav-slot">
        <shapes:Path Classes="nut-nav-glyph" Data="{DynamicResource NutIconDiagnostics}" />
      </Panel>
    </Grid>

    <!-- Settings: the whole cog turns, where before the teeth turned around a fixed hub. -->
    <Grid Classes="nut-icon-motion nut-icon-gear" IsVisible="{Binding IsSettings, ElementName=Root}">
      <Panel x:Name="SettingsGlyph" Classes="nut-nav-slot">
        <shapes:Path Classes="nut-nav-glyph" Data="{DynamicResource NutIconSettings}" />
      </Panel>
    </Grid>

    <!-- About: the product information mark uses the same calm breathing cadence as overview. -->
    <Grid Classes="nut-icon-motion nut-icon-lift" IsVisible="{Binding IsAbout, ElementName=Root}">
      <Panel x:Name="AboutGlyph" Classes="nut-nav-slot">
        <shapes:Path Classes="nut-nav-glyph" Data="{DynamicResource NutIconInfo}" />
      </Panel>
    </Grid>
  </Grid>
</UserControl>
