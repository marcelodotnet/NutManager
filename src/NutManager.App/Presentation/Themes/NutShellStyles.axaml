<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NutManager.App.Presentation.Controls">
  <!--
    Shell chrome: title bar, sidebar, navigation, profile card and footer.
    Navigation selection is a restrained accent bar plus a low-contrast surface rather than a
    saturated block, so the selected row reads as emphasis instead of a filled control.
  -->

  <!--
    Fully opaque, deliberately and permanently. The title bar carries the application name and the
    connection state and the footer carries the authorship line, and content scrolls under both, so
    any alpha here puts moving text directly behind fixed text. The glass in this shell belongs to
    the frosted band inside the content area, never to the chrome itself.

    The value stays a theme resource rather than a literal because these two have to follow light and
    dark; what is pinned is the opacity, and NutHeaderBrush is opaque in both themes.
  -->
  <Style Selector="Border.nut-titlebar">
    <Setter Property="Background" Value="{DynamicResource NutHeaderBrush}" />
  </Style>

  <!-- Window buttons follow the platform hit targets; only close gets a destructive hover. -->
  <Style Selector="Button.nut-window-button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nut-window-button /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.nut-window-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.nut-window-button.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E03B4B" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Segmented light/dark control. -->
  <Style Selector="Border.nut-theme-toggle">
    <Setter Property="Background" Value="{DynamicResource NutSurface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.nut-theme-option">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-theme-option /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.nut-theme-option:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.nut-theme-option.selected">
    <Setter Property="Foreground" Value="{DynamicResource NutWarningBrush}" />
  </Style>
  <Style Selector="Button.nut-theme-option.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutWarningSoftBrush}" />
  </Style>
  <Style Selector="Button.nut-theme-option.selected.moon">
    <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
  </Style>
  <Style Selector="Button.nut-theme-option.selected.moon /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutAccentSoftBrush}" />
  </Style>

  <!--
    Theme glyphs. Both take their colour from the button so the selected state keeps working, and
    both move in a way that suits what they are: the sun turns a notch, the moon leans back as if
    setting. Transitions only, so the toggle costs nothing when nobody is pointing at it.

    The sun used to be a disc with its rays on a separate layer, so the rays could turn while the
    disc held still. The library draws it as one shape, so the turn is the whole sun — which is what
    a sun does anyway; it was the disc holding still that had to be arranged for. The rotation is
    45deg because the library's sun has eight rays, so an eighth of a turn lands ray-on-ray and the
    movement reads as the glyph settling rather than as it being knocked out of true.
  -->
  <Style Selector="Path.nut-theme-glyph">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-theme-option:pointerover Path.nut-sun">
    <Setter Property="RenderTransform" Value="rotate(45deg) scale(1.08)" />
  </Style>
  <Style Selector="Button.nut-theme-option.selected Path.nut-sun">
    <Setter Property="RenderTransform" Value="rotate(22.5deg)" />
  </Style>
  <Style Selector="Button.nut-theme-option:pointerover Path.nut-moon">
    <Setter Property="RenderTransform" Value="rotate(-18deg) scale(1.06)" />
  </Style>
  <Style Selector="Button.nut-theme-option.selected Path.nut-moon">
    <Setter Property="RenderTransform" Value="rotate(-10deg)" />
  </Style>

  <Style Selector="Border.nut-shell-header">
    <Setter Property="Background" Value="{DynamicResource NutHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Translucent like the file rail, so the acrylic runs behind the whole window rather than
       stopping at a solid slab down one side. -->
  <Style Selector="Border.nut-shell-sidebar">
    <Setter Property="Background" Value="{DynamicResource NutSidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Button.nut-profile-card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
    <!--
      No adorner. The stock one is a rectangle drawn outside the control, so the selector wore a
      square outline around its rounded surface and read as a glitch; a rounded replacement template
      did not take either. Focus is shown by the card itself instead, below, which is already the
      right shape — so this removes the ring without removing the feedback.
    -->
    <!--
      An empty adorner rather than a null one. The stock ring is a rectangle drawn outside the
      control, in the adorner layer, so it never took the card's corner radius and setting the
      property to null did not dislodge it. Substituting a template that paints nothing does, and
      focus stays visible through the card's own glow below, which is already the right shape.
    -->
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Background="Transparent" BorderThickness="0" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nut-profile-card /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <!--
      The glow spreads well past the card, and the presenter's bounds are a rectangle. Clipped to
      them, a soft round halo came out as a hard square outline — which is what the "square neon"
      actually was, not the focus ring it was mistaken for.
    -->
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Button.nut-profile-card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.nut-profile-card-surface">
    <Setter Property="Background" Value="{DynamicResource NutSurface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000, 0 0 0 0 #00000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-profile-card:pointerover Border.nut-profile-card-surface">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrightBrush}" />
    <Setter Property="BoxShadow" Value="0 0 10 0 #665FA8FF, 0 0 24 3 #335FA8FF" />
  </Style>
  <!--
    The square ring came from the shared Button:focus-visible rule, which puts a 2px border on any
    focused button and knows nothing about this card's rounded shape. Removing the adorner did not
    touch it, because that rule draws on the button itself. This file is included after the control
    styles, so cancelling the thickness here is what actually wins.
  -->
  <Style Selector="Button.nut-profile-card:focus-visible">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!--
    Keyboard focus wears the same glow as hover instead. It follows the card's corner radius because
    the surface draws it, which is what a rectangular ring could never do.
  -->
  <Style Selector="Button.nut-profile-card:focus-visible Border.nut-profile-card-surface">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrightBrush}" />
    <Setter Property="BoxShadow" Value="0 0 10 0 #665FA8FF, 0 0 24 3 #335FA8FF" />
  </Style>

  <Style Selector="Button.nut-profile-menu-item">
    <Setter Property="Background" Value="{DynamicResource NutSurface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,3" />
    <!--
      Width comes from the list, not from the contents. Stretching only the content left the button
      itself sized to what it held, so the active profile — the one carrying the "Ativo" badge — came
      out wider than every other card and the column read as ragged.
    -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.nut-profile-menu-item /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderSubtleBrush}" />
  </Style>
  <Style Selector="Button.nut-profile-menu-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderEmphasisBrush}" />
  </Style>
  <Style Selector="Button.nut-profile-manage">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!--
    Every navigation item fills the sidebar's inner width, so the hover and selected surfaces all
    start and end at the same X regardless of how long the label is. Width comes from the layout,
    never from the content.
  -->
  <Style Selector="Button.nut-navigation-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-navigation-item /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!--
    A row on glass lightens under the pointer, one rung above whatever pane it sits on. Its left
    edge is not touched: that three-pixel bar is how selection is marked, and lighting it on hover
    would say "this is the page you are on" about a row you are merely pointing at.

    The rules below this one are declared after it deliberately. Avalonia resolves equally matching
    setters by declaration order, so pressed and selected win over hover, and pointing at the row
    you are already on — or holding the mouse down on one — does not wash its state away.
  -->
  <Style Selector="Button.nut-navigation-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutGlassRowHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.nut-navigation-item:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceInteractiveBrush}" />
  </Style>
  <Style Selector="Button.nut-navigation-item.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nut-navigation-item.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSelectedSheenBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>

  <!--
    Navigation icon states. Colour eases through a brush transition; selection is still carried by
    the accent bar and the label weight, so motion reinforces the state without shifting its axis.
  -->
  <!--
    ==================== Navigation glyph states ====================
    One glyph per destination, from the icon library. Each family still reacts in a way that suits
    the object it depicts rather than every icon simply turning accent-coloured, but the reaction is
    now the whole glyph: there are no detail layers left to light up on their own.

    Motion uses TransformOperationsTransition, which is the supported way to interpolate
    RenderTransform: the crash seen earlier came from pointing a keyframe Animation at
    RenderTransform, for which no animator is registered. Transitions are state driven, so a
    sidebar at rest costs nothing.
  -->
  <!--
    The wrapper never translates or scales. Every hover motion below is centred on the fixed 20 px
    glyph through the compositor; composing a second RenderTransform on the 32 px viewport changed
    the apparent axis when hover began and made an otherwise aligned icon jump sideways.
  -->
  <Style Selector="Grid.nut-icon-motion">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <!--
    Looping motion cannot be expressed here. A keyframe Animation targeting RenderTransform throws
    "no animator registered" at startup even when its values are TransformOperations, because the
    transition and the animator are separate mechanisms and only the transition supports it. The
    per-destination loops therefore live on the compositor, driven from NutNavigationIcon, and this
    flag is how a style hands the hover state to it.

    Hover only. A selected row keeps its accent colouring but stops moving: the page you are
    already on has no reason to animate forever, and an idle sidebar must cost nothing.
  -->
  <Style Selector="Button.nut-navigation-item:pointerover controls|NutNavigationIcon">
    <Setter Property="IsActive" Value="True" />
  </Style>
  <!--
    The glyph is muted at rest, brightens under the pointer and takes the accent on the selected
    page. Colour is the whole state signal now: the detail layers that used to light up in their own
    semantic colours — cyan and green rack LEDs, a badge over a check, a reading at the end of a
    trace — went with the migration to one shape per icon, and their emphasis would have had to be
    painted onto the silhouette itself, which recolours the whole destination rather than a detail
    of it. Selection remains carried by the accent bar, the label weight and this fill together.
  -->
  <!--
    The 20x20 slot every navigation glyph is scaled into, centred in the 24 box. Measured, the
    library's five navigation icons span 18 to 22 units on their longest side and are not all
    centred on the grid — the cog reaches 0.7 units further left than its neighbours, and the device
    tower sits half a unit right of the axis. Normalising into one box is what makes the column read
    as a single set instead of five drawings that happen to be stacked.
  -->
  <Style Selector="Panel.nut-nav-slot">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.nut-nav-glyph">
    <!-- Uniform, not None: unscaled the glyphs keep the size differences measured above. The
         alignment is what centres the ink, since a Shape's desired size is its scaled ink. -->
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource NutTextMutedBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-navigation-item:pointerover Path.nut-nav-glyph">
    <Setter Property="Fill" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.nut-navigation-item.selected Path.nut-nav-glyph">
    <Setter Property="Fill" Value="{DynamicResource NutAccentBrightBrush}" />
  </Style>
  <!--
    Disabled items keep their geometry but drop all semantic emphasis. Opacity is not used for this:
    the compositor owns that property on these glyphs while a row is hovered, and a style writing it
    at the same time would fight the animation.
  -->
  <Style Selector="Button.nut-navigation-item:disabled Path.nut-nav-glyph">
    <Setter Property="Fill" Value="{DynamicResource NutBorderEmphasisBrush}" />
  </Style>
  <Style Selector="Button.nut-navigation-subitem PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource NutTextMutedBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-navigation-subitem:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
  </Style>

  <!-- Second-level administration entries rendered under an expanded navigation group. -->
  <Style Selector="Button.nut-navigation-subitem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextMutedBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-navigation-subitem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nut-navigation-subitem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.nut-navigation-subitem.selected">
    <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nut-navigation-subitem.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceSelectedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
  </Style>

  <Style Selector="FlyoutPresenter.nut-profile-flyout">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    The flyout carries the product's card surface, and it has to name a brush that exists: this asked
    for NutSurfaceElevatedBrush, which is defined in neither theme. A DynamicResource that resolves
    to nothing leaves the Border with no background at all rather than failing loudly, so the sidebar
    underneath showed straight through the list of profiles. These are the same glass brushes
    Border.nut-card uses, and both themes define them.
  -->
  <!--
    With transparency switched off the flyout takes a solid surface. The glass brush carries its own
    alpha, which is fine for a card sitting on the window's own background but not for a menu
    floating over the sidebar: the profiles were legible only because of what happened to be behind
    them. The rest of the shell honours this preference, and now so does this.
  -->
  <Style Selector="Border.nut-profile-flyout-surface">
    <Setter Property="Background" Value="{DynamicResource NutGlassSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!--
      A literal radius, because NutRadiusLarge is defined in neither theme. A DynamicResource that
      resolves to nothing leaves the corners square rather than failing loudly — the same way this
      surface's background was missing before it — so the flyout was drawn with no rounding at all.
    -->
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BoxShadow" Value="0 12 32 0 #59000000" />
    <!--
      Clipped to its own rounded shape. The list inside scrolls, and without this the cards travelled
      over the corners the surface had gone to the trouble of rounding.
    -->
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!--
    With transparency switched off the flyout takes a solid surface, and this has to come after the
    rule above to win. The glass brush carries its own alpha, which is fine for a card sitting on the
    window's own background but not for a menu floating over the sidebar: the profile list stayed
    see-through while the rest of the shell had gone opaque.
  -->
  <Style Selector="Border.nut-profile-flyout-surface.opaque">
    <Setter Property="Background" Value="{DynamicResource NutSurface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderBrush}" />
  </Style>

  <Style Selector="Border.nut-profile-avatar">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource NutSurface3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>


  <!-- Opaque for the same reason as the title bar above: the authorship line has to stay legible
       over whatever the page is showing, and the page scrolls underneath it. -->
  <Style Selector="Border.nut-footer">
    <Setter Property="Background" Value="{DynamicResource NutHeaderBrush}" />
  </Style>

  <!--
    ==================== Administration section tabs ====================
    The four administration sections, across the top rather than down a column. They keep the
    shell's selection language — accent, sheen, semibold — but turned on its side: a horizontal
    strip marks the current item with an underline, because a bar down the left of a wide short
    chip reads as a bullet point rather than as a selection.
  -->
  <Style Selector="ListBox.nut-section-tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nut-section-tabs ListBoxItem">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="13,9" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.nut-section-tabs ListBoxItem /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nut-section-tabs ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutGlassRowHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nut-section-tabs ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSelectedSheenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nut-section-tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nut-section-tabs ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource NutAccentBrightBrush}" />
  </Style>

  <!--
    ==================== Configuration file strip ====================
    The five NUT files, as a row of square tiles above the editor rather than a column beside it.
    Built from the same pieces as the section tabs above them, so the page reads as one idea at two
    levels: pick a section, then pick a file, then work — each step costing one row instead of one
    column.

    Squares of one fixed size, not pills that fit their own labels. Five equal tiles read as one set
    of five files of equal standing; five differently sized rounded capsules read as unrelated
    buttons that happen to be adjacent, and the eye has to measure each one to see it is a peer of
    the others.
  -->
  <!--
    The strip is one frame, not five buttons. The frame carries the glass, the outline and the
    rounding; the tiles inside are transparent and draw only a hairline down their right edge, so
    the row reads as a single control with five positions rather than five things placed near each
    other. The last divider is removed by the frame's clip: the strip overhangs by exactly the one
    pixel that divider occupies, which is tidier than asking a style to know which item is last.
  -->
  <Style Selector="Border.nut-file-strip-frame">
    <Setter Property="Background" Value="{DynamicResource NutGlassSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <!-- The frame is glass, so pointing anywhere in the strip lifts its edge the way a card's does. -->
  <Style Selector="Border.nut-file-strip-frame:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource NutGlassBorderHoverBrush}" />
  </Style>
  <Style Selector="ItemsControl.nut-file-strip">
    <Setter Property="Margin" Value="0,0,-1,0" />
  </Style>

  <!--
    One square per file, all the same square, butted against their neighbours. Sized here rather
    than bound, because there is no fold left to animate between two sizes.
  -->
  <Style Selector="Button.nut-file-tile">
    <Setter Property="Width" Value="108" />
    <Setter Property="Height" Value="108" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource NutGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <!--
    A Button paints through its ContentPresenter, so every surface state is set there: the stock
    template binds the presenter's Background to the Button's, and overriding the presenter breaks
    that binding and leaves the tile invisible.
  -->
  <Style Selector="Button.nut-file-tile /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <!-- The same glass response the cards and the sidebar rows use. -->
  <Style Selector="Button.nut-file-tile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutGlassRowHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.nut-file-tile:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSurfaceInteractiveBrush}" />
  </Style>
  <!-- Selection is the filled segment plus the accent underline, declared after hover so pointing
       at the file you already have open cannot wash away the fact that it is open. -->
  <Style Selector="Button.nut-file-tile.selected">
    <Setter Property="Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nut-file-tile.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NutSelectedSheenBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NutTextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.nut-file-tile-marker">
    <Setter Property="Height" Value="3" />
    <Setter Property="Margin" Value="-8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nut-file-tile.selected Border.nut-file-tile-marker">
    <Setter Property="Background" Value="{DynamicResource NutAccentBrush}" />
  </Style>
  <Style Selector="Button.nut-file-tile:disabled">
    <!-- Muted enough to communicate profile scope, but still legible as an available module. -->
    <Setter Property="Opacity" Value="0.62" />
    <Setter Property="Foreground" Value="{DynamicResource NutTextMutedBrush}" />
  </Style>

  <!-- Kept as a class so the two label lines are addressable as one unit. -->
  <Style Selector="StackPanel.nut-file-rail-label">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- A pending draft is shown as a small accent dot, redundant with the item's own state text. -->
  <Style Selector="Ellipse.nut-file-rail-dirty">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource NutWarningBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
