<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="NutSpacing2">2</x:Double>
  <x:Double x:Key="NutSpacing4">4</x:Double>
  <x:Double x:Key="NutSpacing6">6</x:Double>
  <x:Double x:Key="NutSpacing8">8</x:Double>
  <x:Double x:Key="NutSpacing12">12</x:Double>
  <x:Double x:Key="NutSpacing16">16</x:Double>
  <x:Double x:Key="NutSpacing20">20</x:Double>
  <x:Double x:Key="NutSpacing24">24</x:Double>
  <x:Double x:Key="NutSpacing32">32</x:Double>
  <x:Double x:Key="NutRadius6">6</x:Double>
  <x:Double x:Key="NutRadius8">8</x:Double>
  <x:Double x:Key="NutRadius10">10</x:Double>
  <x:Double x:Key="NutRadius12">12</x:Double>
  <x:Double x:Key="NutRadius14">14</x:Double>
  <x:Double x:Key="NutRadius16">16</x:Double>
  <CornerRadius x:Key="NutCardCornerRadius">14</CornerRadius>
  <CornerRadius x:Key="NutControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="NutPillCornerRadius">999</CornerRadius>
  <x:Double x:Key="NutControlHeight">38</x:Double>
  <x:Double x:Key="NutIconSizeSmall">16</x:Double>
  <x:Double x:Key="NutIconSize">18</x:Double>
  <x:Double x:Key="NutIconSizeLarge">20</x:Double>
  <x:Double x:Key="NutNavigationIconSize">20</x:Double>
  <GridLength x:Key="NutTitleBarHeight">48</GridLength>
  <GridLength x:Key="NutHeaderHeight">64</GridLength>
  <x:Double x:Key="NutSidebarExpandedWidth">220</x:Double>
  <x:Double x:Key="NutSidebarCollapsedWidth">72</x:Double>

  <x:Double x:Key="NutReviewDrawerWidth">368</x:Double>
  <GridLength x:Key="NutFooterHeight">30</GridLength>
  <!-- How far the edge vignette reaches in from each side of the content area. Wide enough to be a
       falloff rather than a line, and wide enough to reach the first card: confined to the page's
       own padding it lands only on empty background and is invisible. -->
  <x:Double x:Key="NutContentVignetteWidth">72</x:Double>
  <Thickness x:Key="NutPagePadding">28</Thickness>
  <Thickness x:Key="NutCardPadding">18</Thickness>
  <Thickness x:Key="NutCardPaddingCompact">14</Thickness>
</ResourceDictionary>
