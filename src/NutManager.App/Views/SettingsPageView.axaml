<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             x:Class="NutManager.App.Views.SettingsPageView"
             x:DataType="viewModels:SettingsPageViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ValidationIssueTemplate" x:DataType="viewModels:LocalizedValidationIssueViewModel">
      <Grid Margin="0,2,0,0">
        <TextBlock Text="{Binding Message}"
                   IsVisible="{Binding IsError}"
                   Foreground="{DynamicResource NutCriticalBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding Message}" />
        <TextBlock Text="{Binding Message}"
                   IsVisible="{Binding IsWarning}"
                   Foreground="{DynamicResource NutWarningBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding Message}" />
        <TextBlock Text="{Binding Message}"
                   IsVisible="{Binding IsInfo}"
                   Foreground="{DynamicResource NutTextSecondaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding Message}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="SettingsScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                AllowAutoHide="False">
    <StackPanel Spacing="26" MaxWidth="1180" Margin="0,92,10,58">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="11">
          <TextBlock Text="{Binding Title}" Classes="nut-page-title" />
          <PathIcon Data="{DynamicResource NutIconSettings}" Width="20" Height="20" Foreground="{DynamicResource NutAccentBrightBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding Description}" Classes="nut-page-subtitle" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Appearance and language preferences. The full theme preference (System/Light/Dark) stays
           here; the header toggle is a shortcut, not a replacement. -->
      <Border Classes="nut-card">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{DynamicResource NutIconSun}" Classes="warning" Width="17" Height="17" />
            <TextBlock Text="{Binding AppearanceTitle}" Classes="nut-card-title" VerticalAlignment="Center" />
          </StackPanel>
          <Border Classes="nut-divider" />
          <!-- Four columns declared here as well as in the responsive pass: the pass only runs on
               the first SizeChanged, and until then a panel placed in a column the grid does not
               have is clamped onto its neighbour and the two draw on top of each other. -->
          <!-- The boxes are a fixed 200 rather than stretched: filling a quarter of the card made
               a three-word choice look like a text field, and one fixed width keeps the four
               controls on a common left edge instead of ending wherever their content does. -->
          <Grid x:Name="AppearanceLayout" ColumnDefinitions="*,*,*,*" ColumnSpacing="26">
            <StackPanel x:Name="ThemePreferencePanel" Grid.Column="0" Spacing="5">
              <TextBlock Text="{Binding AppearanceThemeLabel}" Classes="nut-label" />
              <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" HorizontalAlignment="Left" Width="200">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel x:Name="LanguagePreferencePanel" Grid.Column="1" Spacing="5">
              <TextBlock Text="{Binding AppearanceLanguageLabel}" Classes="nut-label" />
              <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption}" HorizontalAlignment="Left" Width="200">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel x:Name="SidebarPreferencePanel" Grid.Column="2" Spacing="5">
              <TextBlock Text="{Binding AppearanceSidebarLabel}" Classes="nut-label" />
              <ComboBox ItemsSource="{Binding SidebarOptions}" SelectedItem="{Binding SelectedSidebarOption}" HorizontalAlignment="Left" Width="200">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <!--
              A switch, not a fourth dropdown. The three beside it pick one of several values; this
              one is on or off, and a two-item list is a worse control for that than a switch is.
            -->
            <StackPanel x:Name="TransparencyPreferencePanel" Grid.Column="3" Spacing="5">
              <!--
                The hint appears only while the switch is disabled. A permanent question mark next to
                a control that works is noise; one that shows up exactly when the control stops
                responding answers the question the user is about to ask.
              -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding AppearanceTransparencyLabel}" Classes="nut-label" />
                <PathIcon Data="{DynamicResource NutIconHelp}"
                          Classes="muted"
                          Width="13" Height="13"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !IsTransparencyAvailable}"
                          ToolTip.Tip="{Binding AppearanceTransparencyDarkOnly}"
                          AutomationProperties.Name="{Binding AppearanceTransparencyDarkOnly}" />
              </StackPanel>
              <ToggleSwitch IsChecked="{Binding IsTransparencyEffective}"
                            IsEnabled="{Binding IsTransparencyAvailable}"
                            OnContent="{Binding AppearanceTransparencyOn}"
                            OffContent="{Binding AppearanceTransparencyOff}"
                            AutomationProperties.Name="{Binding AppearanceTransparencyLabel}" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding IsLanguageRestartRequired}">
            <PathIcon Data="{DynamicResource NutIconInfo}" Classes="warning" Width="14" Height="14" VerticalAlignment="Top" />
            <TextBlock Text="{Binding RestartLanguageMessage}" Classes="warning" FontSize="12.5" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ManagedServersCard" Classes="nut-card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
            <PathIcon Data="{DynamicResource NutIconServer}" Classes="accent" Width="17" Height="17" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding ManagedServersTitle}" Classes="nut-card-title" />
              <TextBlock Classes="nut-metadata" TextWrapping="Wrap">
                <Run Text="{Binding RuntimeProfileLabel}" /><Run Text=": " /><Run Text="{Binding RuntimeProfileName}" />
                <Run Text="  •  " />
                <Run Text="{Binding PersistedActiveProfileLabel}" /><Run Text=": " /><Run Text="{Binding PersistedActiveProfileName}" />
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="2"
                    Classes="nut-primary"
                    Command="{Binding NewServerCommand}"
                    AutomationProperties.Name="{Binding NewServerText}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Classes="nut-icon-add" Data="{DynamicResource NutIconAdd}" Width="14" Height="14" />
                <TextBlock Text="{Binding NewServerText}" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Classes="nut-card-flat"
                  Padding="12"
                  BorderBrush="{DynamicResource NutWarningBrush}"
                  IsVisible="{Binding IsActiveProfileRestartRequired}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{DynamicResource NutIconInfo}" Classes="warning" Width="16" Height="16" VerticalAlignment="Top" />
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding RestartRequiredTitle}" FontSize="13" FontWeight="SemiBold" Classes="warning" />
                <TextBlock Text="{Binding RestartRequiredMessage}" Classes="nut-metadata" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid x:Name="ManagedProfilesLayout"
                ColumnDefinitions="330,16,*"
                RowDefinitions="Auto,14,Auto,16,Auto">
            <Grid x:Name="ProfileListPanel"
                  Grid.Row="2"
                  Grid.Column="0"
                  RowDefinitions="*,6,Auto">
              <!--
                A fixed height, so the buttons underneath never move. Anything elastic — a minimum, a
                maximum, a stretch — still lets the list grow until it hits the bound, and until then
                every added server pushes Tornar ativo and Excluir further down the page. Pinning the
                height instead means one server or ten produce the same panel, and the overflow goes
                to the ListBox's own ScrollViewer, where the shared scrollbar styling already
                applies.

                Both edges line up with the monitoring card opposite, and each for its own reason.

                The bottom: the column opposite is a StackPanel, which takes the height of its
                content and does not stretch, so whichever side is taller sizes the row. Set too
                tall, this side won that measure, the row grew past the card, and the buttons — which
                sit on the row's bottom edge — ended below where the card stopped. Kept short enough,
                the card sizes the row and the buttons land level with it.

                The top: anchored rather than stretched. A stretch bounded by a maximum centres what
                is left over, which pushed the list down the row and opened a gap above it while the
                bottom stayed put.
              -->
              <Border CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top" Height="210">
                <ListBox ItemsSource="{Binding ManagedProfileCards}"
                         SelectedItem="{Binding SelectedProfileCard, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ManagedProfileCardViewModel">
                      <!--
                        A hairline under each row, so the servers read as separate entries rather
                        than as one running column of text. It is drawn by the row itself rather than
                        by a separator element placed between rows, because the list virtualises and
                        anything that is not part of a row has nothing to be recycled with.
                      -->
                      <!--
                        Emphasis rather than the subtle border: at #1A2230 against this surface the
                        hairline was very nearly the background itself — a divider in the markup and
                        nowhere else.
                      -->
                      <Border BorderBrush="{DynamicResource NutBorderEmphasisBrush}"
                              BorderThickness="0,0,0,1"
                              Padding="0,0,0,9"
                              Margin="0,0,0,2">
                      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" MinWidth="220" RowSpacing="3">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="nut-pill healthy" Padding="8,2" IsVisible="{Binding IsActive}">
                          <TextBlock Text="{Binding ActiveText}" Classes="healthy" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Endpoint}" Classes="nut-metadata" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" ItemSpacing="5" LineSpacing="3">
                          <Border Classes="nut-pill" Padding="7,1">
                            <TextBlock Text="{Binding ManagementMode}" FontSize="11" Classes="nut-metadata" />
                          </Border>
                          <Border Classes="nut-pill" Padding="7,1">
                            <TextBlock Text="{Binding AccessMode}" FontSize="11" Classes="nut-metadata" />
                          </Border>
                          <Border Classes="nut-pill" Padding="7,1" IsVisible="{Binding HasTransport}">
                            <TextBlock Text="{Binding Transport}" FontSize="11" Classes="nut-metadata" />
                          </Border>
                        </WrapPanel>
                      </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
              <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
                <Button Content="{Binding ActivateProfileText}"
                        Command="{Binding ActivateSelectedProfileCommand}"
                        IsEnabled="{Binding CanActivateSelectedProfile}"
                        HorizontalAlignment="Stretch" />
                <Button Grid.Column="1"
                        Classes="nut-danger"
                        Content="{Binding DeleteProfileText}"
                        Command="{Binding DeleteSelectedProfileCommand}"
                        IsEnabled="{Binding CanDeleteSelectedProfile}"
                        HorizontalAlignment="Stretch" />
              </Grid>
            </Grid>

            <!-- The list and the complete monitoring editor are peers in the first row. The
                 server name belongs beside the host because both identify the endpoint; port and
                 preferred UPS form the second row below them. -->
            <StackPanel x:Name="ProfileEditorHeader"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">
              <PathIcon Data="{DynamicResource NutIconEdit}" Classes="accent" Width="16" Height="16" />
              <TextBlock Text="{Binding EditorTitle}" Classes="nut-card-title" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="ProfileIdentityPanel" Grid.Row="2" Grid.Column="2">
              <Border x:Name="ProfileMonitoringPanel" Classes="nut-card-flat" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding MonitoringSectionTitle}" FontWeight="SemiBold" FontSize="16" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding NameLabel}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ProfileDraft.Name, Mode=TwoWay}"
                               AutomationProperties.Name="{Binding NameLabel}" />
                      <ItemsControl ItemsSource="{Binding NameValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="{Binding MonitoringHostLabel}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ProfileDraft.MonitoringHost, Mode=TwoWay}"
                               AutomationProperties.Name="{Binding MonitoringHostLabel}" />
                      <ItemsControl ItemsSource="{Binding MonitoringHostValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding MonitoringPortLabel}" FontWeight="SemiBold" />
                      <NumericUpDown Value="{Binding ProfileDraft.MonitoringPortValue, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="65535"
                                     Increment="1"
                                     ParsingNumberStyle="Integer"
                                     FormatString="0"
                                     AutomationProperties.Name="{Binding MonitoringPortLabel}" />
                      <ItemsControl ItemsSource="{Binding MonitoringPortValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="{Binding PreferredUpsLabel}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ProfileDraft.PreferredUpsName, Mode=TwoWay}" AutomationProperties.Name="{Binding PreferredUpsLabel}" />
                      <ItemsControl ItemsSource="{Binding PreferredUpsValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="nut-primary"
                            Content="{Binding TestConnectionText}"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding CanTestConnection}" />
                    <TextBlock Text="{Binding ConnectionTestResultText}"
                               IsVisible="{Binding IsConnectionTestHealthy}"
                               Foreground="{DynamicResource NutHealthyBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding ConnectionTestResultText}" />
                    <TextBlock Text="{Binding ConnectionTestResultText}"
                               IsVisible="{Binding IsConnectionTestWarning}"
                               Foreground="{DynamicResource NutWarningBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding ConnectionTestResultText}" />
                    <TextBlock Text="{Binding ConnectionTestResultText}"
                               IsVisible="{Binding IsConnectionTestCritical}"
                               Foreground="{DynamicResource NutCriticalBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding ConnectionTestResultText}" />
                    <TextBlock Text="{Binding ConnectionTestResultText}"
                               IsVisible="{Binding IsConnectionTestNeutral}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding ConnectionTestResultText}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="ProfileEditorPanel"
                        Grid.Row="4"
                        Grid.ColumnSpan="3"
                        Spacing="14">

              <Border Classes="nut-card-flat" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding ManagementSectionTitle}" FontWeight="SemiBold" FontSize="16" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding ManagementModeLabel}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding ManagementModeOptions}" SelectedItem="{Binding SelectedManagementModeOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="{Binding AccessModeLabel}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding AccessModeOptions}" SelectedItem="{Binding SelectedAccessModeOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <StackPanel IsVisible="{Binding ProfileDraft.IsRemote}" Spacing="10">
                    <TextBlock Text="{Binding TransportSectionTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding TransportLabel}" />
                    <ComboBox ItemsSource="{Binding ConfigurationTransportOptions}" SelectedItem="{Binding SelectedConfigurationTransportOption, Mode=TwoWay}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel IsVisible="{Binding ProfileDraft.IsSshSftp}" Spacing="8">
                      <TextBlock Text="{Binding ManagementHostLabel}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ProfileDraft.ManagementHost, Mode=TwoWay}" AutomationProperties.Name="{Binding ManagementHostLabel}" />
                      <ItemsControl ItemsSource="{Binding ManagementHostValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding SshPortLabel}" FontWeight="SemiBold" />
                          <TextBox Text="{Binding ProfileDraft.SshPort, Mode=TwoWay}" AutomationProperties.Name="{Binding SshPortLabel}" />
                          <ItemsControl ItemsSource="{Binding SshPortValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="{Binding SshUsernameLabel}" FontWeight="SemiBold" />
                          <TextBox Text="{Binding ProfileDraft.SshUsername, Mode=TwoWay}" AutomationProperties.Name="{Binding SshUsernameLabel}" />
                          <ItemsControl ItemsSource="{Binding SshUsernameValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding SshAuthenticationLabel}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding SshAuthenticationOptions}" SelectedItem="{Binding SelectedSshAuthenticationOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <StackPanel IsVisible="{Binding ProfileDraft.IsSshPrivateKey}" Spacing="6">
                        <TextBlock Text="{Binding PrivateKeyLabel}" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding ProfileDraft.SshPrivateKeyPath, Mode=TwoWay}" AutomationProperties.Name="{Binding PrivateKeyLabel}" />
                          <Button Grid.Column="1" Content="{Binding SelectPrivateKeyText}" Click="SelectSshPrivateKeyButton_OnClick" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SshPrivateKeyValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                        <TextBlock Text="{Binding PrivateKeyMetadataHelp}" FontSize="12" Foreground="{DynamicResource NutTextSecondaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Text="{Binding RemoteDirectoryLabel}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ProfileDraft.RemoteConfigurationDirectory, Mode=TwoWay}" AutomationProperties.Name="{Binding RemoteDirectoryLabel}" />
                      <ItemsControl ItemsSource="{Binding RemoteDirectoryValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                      <TextBlock Text="{Binding TrustedHostKeyLabel}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ProfileDraft.TrustedHostKeyFingerprint}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ProfileDraft.TrustedHostKeyAlgorithm}" TextWrapping="Wrap" />
                      <Button Content="{Binding ForgetHostKeyText}" Command="{Binding ForgetTrustedHostKeyCommand}" IsEnabled="{Binding CanForgetTrustedHostKey}" HorizontalAlignment="Left" />
                      <TextBlock Text="{Binding ProtectedSecretHelp}" FontSize="12" Foreground="{DynamicResource NutTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ProfileDraft.IsSmb}" Spacing="8">
                      <TextBlock Text="{Binding SmbShareLabel}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ProfileDraft.SmbSharePath, Mode=TwoWay}" PlaceholderText="\\server\share" AutomationProperties.Name="{Binding SmbShareLabel}" />
                      <ItemsControl ItemsSource="{Binding SmbShareValidationIssues}" ItemTemplate="{StaticResource ValidationIssueTemplate}" />
                      <TextBlock Text="{Binding SmbAuthenticationLabel}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding SmbAuthenticationOptions}" SelectedItem="{Binding SelectedSmbAuthenticationOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <!--
                        There is deliberately no user name and no configuration-directory field.
                        The share is the exact location of the NUT files, and for another Windows
                        account the identity comes back from the Windows credential dialog rather
                        than being typed here. Current Windows identity needs nothing further.

                        The help text names the Administration page for the same reason: this
                        surface reports whether a credential is stored and can forget it, but
                        signing in happens there. Saying so is the difference between a deliberate
                        split and a dead end — without it the operator selects explicit credentials
                        and finds no way to supply one.
                      -->
                      <TextBlock Text="{Binding SmbSecretHelp}"
                                 IsVisible="{Binding ProfileDraft.UsesSmbExplicitCredentials}"
                                 FontSize="12"
                                 Foreground="{DynamicResource NutTextSecondaryBrush}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SmbLegacyDirectoryText}"
                                 IsVisible="{Binding ProfileDraft.HasLegacySmbConfigurationDirectory}"
                                 FontSize="12"
                                 Foreground="{DynamicResource NutWarningBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>


                    <!--
                      Windows agent (T36). Deliberately its own block rather than part of the SMB or
                      SFTP sections: the agent transport is independent of the configuration
                      transport, and editing files over SMB while controlling the service over a
                      named pipe is an ordinary combination.
                    -->
                    <StackPanel IsVisible="{Binding ProfileDraft.IsAgentSectionVisible}" Spacing="8">
                      <TextBlock Text="{Binding AgentSectionText}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding AgentTransportText}" />
                      <ComboBox ItemsSource="{Binding AgentTransportOptions}"
                                SelectedItem="{Binding SelectedAgentTransportOption, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding AgentTransportText}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>

                      <!-- The pipe carries the Windows identity the application already has, so it
                           offers no endpoint and no account to choose. -->
                      <TextBlock Text="{Binding AgentNamedPipeNoticeText}"
                                 IsVisible="{Binding ProfileDraft.IsAgentNamedPipe}"
                                 FontSize="12"
                                 Foreground="{DynamicResource NutTextSecondaryBrush}"
                                 TextWrapping="Wrap" />

                      <StackPanel IsVisible="{Binding ProfileDraft.IsAgentHttps}" Spacing="8">
                        <TextBlock Text="{Binding AgentHttpsEndpointText}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ProfileDraft.AgentHttpsEndpoint, Mode=TwoWay}"
                                 PlaceholderText="https://servidor:5199/"
                                 AutomationProperties.Name="{Binding AgentHttpsEndpointText}" />
                        <TextBlock Text="{Binding AgentHttpsEndpointInvalidText}"
                                   IsVisible="{Binding ProfileDraft.HasInvalidAgentHttpsEndpoint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource NutWarningBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding AgentAuthenticationText}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AgentAuthenticationOptions}"
                                  SelectedItem="{Binding SelectedAgentAuthenticationOption, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding AgentAuthenticationText}">
                          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- The account name, never a password box: the secret is collected by the
                             Windows credential dialog and stored under the agent's own entry. -->
                        <StackPanel IsVisible="{Binding ProfileDraft.UsesAgentAlternateAccount}" Spacing="6">
                          <!--
                            The account and the credential are separate facts and get separate
                            labels. A profile can name an account it holds no secret for, and
                            printing the credential status under a heading that reads "Account"
                            made a configured account look like no account at all.
                          -->
                          <TextBlock Text="{Binding AgentAccountText}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding AgentAccountStatusText}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding AgentAccountStatusText}" />

                          <TextBlock Text="{Binding AgentCredentialLabel}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding AgentCredentialStatusText}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding AgentCredentialStatusText}" />

                          <!--
                            The secret is collected by the Windows credential dialog and proven
                            against the agent before anything is remembered. There is no password
                            box here and there is not meant to be one.
                          -->
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding AgentAuthenticateText}"
                                    Command="{Binding AuthenticateAgentCredentialCommand}"
                                    IsEnabled="{Binding CanAuthenticateAgentCredential}"
                                    AutomationProperties.Name="{Binding AgentAuthenticateText}" />
                            <Button Content="{Binding AgentForgetText}"
                                    Command="{Binding ForgetAgentCredentialCommand}"
                                    IsEnabled="{Binding CanForgetAgentCredential}"
                                    AutomationProperties.Name="{Binding AgentForgetText}" />
                          </StackPanel>

                          <CheckBox Content="{Binding AgentRememberText}"
                                    IsChecked="{Binding RememberAgentCredential, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding AgentRememberText}" />

                          <TextBlock Text="{Binding AgentAuthenticatingText}"
                                     IsVisible="{Binding IsAuthenticatingAgentCredential}"
                                     FontSize="12"
                                     Foreground="{DynamicResource NutTextSecondaryBrush}"
                                     AutomationProperties.Name="{Binding AgentAuthenticatingText}" />

                          <TextBlock Text="{Binding AgentAlternateAccountNoticeText}"
                                     FontSize="12"
                                     Foreground="{DynamicResource NutTextSecondaryBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                    <!--
                      This credential belongs to the configuration transport, not to the agent, and
                      it sits directly under the agent's own credential block. Unlabelled, the two
                      read as one surface contradicting itself: "credential saved" immediately above
                      "no protected credential is required". The heading is what separates them.
                    -->
                    <TextBlock Text="{Binding ConfigurationCredentialLabel}" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StoredCredentialText}" TextWrapping="Wrap" />
                    <Button Content="{Binding ForgetCredentialText}" Command="{Binding ForgetStoredCredentialCommand}" IsEnabled="{Binding CanForgetStoredCredential}" HorizontalAlignment="Left" />

                    <!--
                      Which of the five supported files this profile exposes. This is intent, not
                      inventory: a file can be enabled and currently missing, and detection only
                      changes these boxes when the administrator explicitly asks it to.
                    -->
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding ManagedFilesLabel}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ManagedFilesHelp}" FontSize="12"
                                 Foreground="{DynamicResource NutTextSecondaryBrush}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding ProfileDraft.ManagedFileToggles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Content="{Binding FileName}"
                                      AutomationProperties.Name="{Binding FileName}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding ManagedFilesNoneWarning}"
                                 IsVisible="{Binding ProfileDraft.HasNoManagedFiles}"
                                 FontSize="12"
                                 Foreground="{DynamicResource NutWarningBrush}"
                                 TextWrapping="Wrap" />
                      <!-- Detection runs only when asked, and lands in the draft, which still has to be saved. -->
                      <Button Content="{Binding ManagedFilesDetectText}"
                              Command="{Binding DetectManagedFilesCommand}"
                              IsEnabled="{Binding CanDetectManagedFiles}"
                              AutomationProperties.Name="{Binding ManagedFilesDetectText}"
                              HorizontalAlignment="Left" />
                      <TextBlock Text="{Binding ManagedFilesDetectHint}"
                                 IsVisible="{Binding HasManagedFilesDetectHint}"
                                 Classes="nut-metadata"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ManagedFilesDetectionMessage}"
                                 IsVisible="{Binding HasManagedFilesDetectionMessage}"
                                 Classes="nut-metadata"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding ManagedFilesDetectionMessage}" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Text="{Binding LocalManagementHelp}"
                             IsVisible="{Binding !ProfileDraft.IsRemote}"
                             Foreground="{DynamicResource NutTextSecondaryBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="nut-card-flat"
                      Padding="12"
                      BorderBrush="{DynamicResource NutWarningBrush}"
                      IsVisible="{Binding IsDirtyDraftDecisionVisible}">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <PathIcon Data="{DynamicResource NutIconWarning}" Classes="warning" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DirtyDraftTitle}" FontSize="13" FontWeight="SemiBold" Classes="warning" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding DirtyDraftMessage}" Classes="nut-metadata" TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <Button Classes="nut-primary" Content="{Binding SaveAndContinueText}" Command="{Binding SaveDirtyDraftAndContinueCommand}" IsEnabled="{Binding CanSaveProfile}" />
                    <Button Content="{Binding DiscardAndContinueText}" Command="{Binding DiscardDirtyDraftAndContinueCommand}" />
                    <Button Content="{Binding ContinueEditingText}" Command="{Binding ContinueEditingCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </Grid>

          <Border Classes="nut-divider" Margin="0,4" />
          <StackPanel x:Name="GeneralSettingsSection" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{DynamicResource NutIconConnection}" Classes="cyan" Width="17" Height="17" />
            <TextBlock Text="{Binding GeneralSettingsTitle}" Classes="nut-card-title" VerticalAlignment="Center" />
          </StackPanel>
          <Border Classes="nut-divider" />
          <Grid x:Name="GeneralPreferencesLayout" ColumnDefinitions="220,220" ColumnSpacing="18">
            <StackPanel x:Name="ConnectionTimeoutPanel" Spacing="5">
              <TextBlock Text="{Binding ConnectionTimeoutLabel}" Classes="nut-label" />
              <NumericUpDown Value="{Binding ConnectionTimeoutSecondsValue, Mode=TwoWay}"
                             Minimum="1"
                             Increment="1"
                             ParsingNumberStyle="Float"
                             FormatString="0.##"
                             Width="220"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="{Binding ConnectionTimeoutLabel}" />
            </StackPanel>
            <StackPanel x:Name="PollingIntervalPanel" Grid.Column="1" Spacing="5">
              <TextBlock Text="{Binding PollingIntervalLabel}" Classes="nut-label" />
              <NumericUpDown Value="{Binding PollingIntervalSecondsValue, Mode=TwoWay}"
                             Minimum="1"
                             Increment="1"
                             ParsingNumberStyle="Float"
                             FormatString="0.##"
                             Width="220"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="{Binding PollingIntervalLabel}" />
            </StackPanel>
          </Grid>

            <!-- One deliberate commit point for this card: the profile is persisted first and the
                 general preferences follow only after it succeeds. -->
            <Grid x:Name="SettingsCommitBar" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
              <Button Classes="nut-primary"
                      Content="{Binding SaveSettingsText}"
                      Click="SaveAllButton_OnClick"
                      IsEnabled="{Binding CanSaveAll}" />
              <Button Grid.Column="1"
                      Content="{Binding DiscardProfileText}"
                      Command="{Binding DiscardAllCommand}"
                      IsEnabled="{Binding CanDiscardAll}" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="{Binding ProfileSavingText}" IsVisible="{Binding IsSavingProfile}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SavingText}" IsVisible="{Binding IsSaving}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ProfileStatusMessage}" IsVisible="{Binding HasProfileStatusMessage}" Foreground="{DynamicResource NutHealthyBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SettingsSavedText}" IsVisible="{Binding IsSaved}" Foreground="{DynamicResource NutHealthyBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ProfileSaveError}" IsVisible="{Binding HasProfileSaveError}" Foreground="{DynamicResource NutCriticalBrush}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ProfileSaveError}" />
                <TextBlock Text="{Binding ProfileLoadError}" IsVisible="{Binding HasProfileLoadError}" Foreground="{DynamicResource NutCriticalBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}" Foreground="{DynamicResource NutCriticalBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LoadError}" IsVisible="{Binding HasLoadError}" Foreground="{DynamicResource NutCriticalBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
