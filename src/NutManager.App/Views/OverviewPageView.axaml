<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
             xmlns:controls="clr-namespace:NutManager.App.Presentation.Controls"
             x:Class="NutManager.App.Views.OverviewPageView"
             x:DataType="viewModels:OverviewPageViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ActiveConfigurationRowTemplate" x:DataType="viewModels:OverviewInfoRowViewModel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,9">
        <TextBlock Text="{Binding Label}"
                   Classes="nut-metadata"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <!-- Static by design: Agent reachability must not pulse, glow or animate. -->
          <Ellipse Classes="nut-agent-status-dot"
                   Classes.healthy="{Binding IsHealthy}"
                   Classes.critical="{Binding IsCritical}"
                   IsVisible="{Binding HasStatusIndicator}" />
          <TextBlock Text="{Binding Value}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Classes.accent="{Binding IsAccent}"
                     Classes.muted="{Binding !IsAccent}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <!--
    UPS dashboard composed against the approved reference: one compact metric band above a two by
    two lower grid. Every reading is projected from the current snapshot; a missing NUT variable
    keeps the card composition and renders the unavailable label in a reduced style instead of a
    substituted number.
  -->
  <!--
    AllowAutoHide="False" makes the vertical scroll bar reserve its own layout column instead of
    floating over the content, so it can never sit on top of the header readout or the cards. The
    gutter only exists while the bar is shown, so no width is wasted when the page fits.
  -->
  <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                AllowAutoHide="False">
    <StackPanel Spacing="16" Margin="0,92,10,58">

      <!-- ==================== Page header ==================== -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="11">
            <TextBlock Text="{Binding Title}" Classes="nut-page-title" />
            <PathIcon Data="{DynamicResource NutIconDiagnostics}"
                      Width="20"
                      Height="20"
                      Foreground="{DynamicResource NutAccentBrightBrush}"
                      VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Description}" Classes="nut-page-subtitle" MaxWidth="760" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Border Classes="nut-pill warning" IsVisible="{Binding IsSimulated}" Padding="10,4">
            <TextBlock Text="{Binding SourceLabel}" FontSize="12" FontWeight="SemiBold" Classes="warning" />
          </Border>
          <PathIcon Data="{DynamicResource NutIconRefresh}"
                    Width="17"
                    Height="17"
                    Foreground="{DynamicResource NutCyanBrush}"
                    VerticalAlignment="Center" />
          <StackPanel Spacing="1">
            <TextBlock Text="{Binding Strings[Overview.LastReading]}" Classes="nut-metadata" />
            <TextBlock Text="{Binding LastSuccessfulUpdateText}" FontSize="12.5" Classes="accent" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" />

      <Border Classes="nut-card" Padding="14" IsVisible="{Binding HasLoadError}" BorderBrush="{DynamicResource NutCriticalBrush}">
        <StackPanel Orientation="Horizontal" Spacing="11">
          <PathIcon Data="{DynamicResource NutIconWarning}" Classes="critical" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Classes="nut-body" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- ==================== Metric band ==================== -->
      <WrapPanel>
        <!-- Battery -->
        <Border Classes="nut-metric-card healthy">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Data="{DynamicResource NutIconBattery}" Classes="nut-icon-battery healthy" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.Metric.BatteryCharge]}" Classes="nut-metric-label" />
            </StackPanel>
            <TextBlock Text="{Binding BatteryValueText}"
                       Classes="nut-metric-value healthy"
                       IsVisible="{Binding HasBatteryPercent}" />
            <TextBlock Text="{Binding UnavailableLabel}"
                       Classes="nut-metric-unavailable"
                       IsVisible="{Binding !HasBatteryPercent}" />
            <ProgressBar Classes="nut-value-bar"
                         Classes.healthy="{Binding HasBatteryPercent}"
                         Classes.unavailable="{Binding !HasBatteryPercent}"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding BatteryBarValue}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBatteryStateText}">
                <PathIcon Data="{DynamicResource NutIconInfo}" Classes="muted" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BatteryStateText}" Classes="nut-metadata" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding BatteryVoltageText}"
                         Classes="nut-metadata"
                         IsVisible="{Binding HasBatteryVoltage}"
                         VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Load -->
        <Border Classes="nut-metric-card cyan">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Data="{DynamicResource NutIconGauge}" Classes="nut-icon-gauge cyan" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.Metric.Load]}" Classes="nut-metric-label" />
            </StackPanel>
            <controls:NutLoadGauge Percent="{Binding LoadPercent}"
                                   DisplayText="{Binding LoadGaugeText}"
                                   Diameter="150"
                                   Thickness="12"
                                   HorizontalAlignment="Center" />
            <TextBlock Text="{Binding LoadPowerText}"
                       Classes="nut-metadata"
                       IsVisible="{Binding HasLoadPowerText}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding UnavailableLabel}"
                       Classes="nut-metadata"
                       IsVisible="{Binding !HasLoadPercent}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Runtime -->
        <Border Classes="nut-metric-card purple">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Data="{DynamicResource NutIconRuntime}" Classes="nut-icon-runtime purple" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.Metric.Runtime]}" Classes="nut-metric-label" />
            </StackPanel>
            <TextBlock Text="{Binding RuntimeValueText}"
                       Classes="nut-metric-value purple"
                       IsVisible="{Binding HasRuntime}" />
            <TextBlock Text="{Binding UnavailableLabel}"
                       Classes="nut-metric-unavailable"
                       IsVisible="{Binding !HasRuntime}" />
            <TextBlock Text="{Binding RuntimeRawText}"
                       Classes="nut-mono"
                       IsVisible="{Binding HasRuntimeRawText}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <!-- Input -->
        <Border Classes="nut-metric-card warning">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Data="{DynamicResource NutIconInput}" Classes="nut-icon-input warning" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.Metric.InputVoltage]}" Classes="nut-metric-label" />
            </StackPanel>
            <TextBlock Text="{Binding InputVoltageText}"
                       Classes="nut-metric-value warning"
                       IsVisible="{Binding HasInputVoltage}" />
            <TextBlock Text="{Binding UnavailableLabel}"
                       Classes="nut-metric-unavailable"
                       IsVisible="{Binding !HasInputVoltage}" />
            <TextBlock Text="{Binding FrequencyText}" Classes="nut-metadata" IsVisible="{Binding HasFrequency}" />
          </StackPanel>
        </Border>

        <!-- Output -->
        <Border Classes="nut-metric-card healthy">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Data="{DynamicResource NutIconOutput}" Classes="nut-icon-output healthy" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.Metric.OutputVoltage]}" Classes="nut-metric-label" />
            </StackPanel>
            <TextBlock Text="{Binding OutputVoltageText}"
                       Classes="nut-metric-value healthy"
                       IsVisible="{Binding HasOutputVoltage}" />
            <TextBlock Text="{Binding UnavailableLabel}"
                       Classes="nut-metric-unavailable"
                       IsVisible="{Binding !HasOutputVoltage}" />
            <TextBlock Text="{Binding FrequencyText}" Classes="nut-metadata" IsVisible="{Binding HasFrequency}" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <!-- ==================== Row 1: UPS state | Connection ==================== -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="13">
        <Border Classes="nut-card">
          <StackPanel Spacing="13">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{DynamicResource NutIconShield}" Classes="healthy" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.State]}" Classes="nut-card-title" VerticalAlignment="Center" />
            </StackPanel>

            <!--
              A grid, not a horizontal stack: a stack hands its children unlimited width along the
              stacking axis, so the description kept claiming its full width and spilled past the
              card, which then clipped it. The star column bounds the text to whatever space is
              actually left, so it wraps instead of overflowing at any card width.
            -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <!--
                The primary status token is the one badge that reports a live condition, so it gets
                a halo that breathes behind it, in the same language as the shell's status light.
                The halo is a separate layer underneath: the badge itself never moves, so the row
                keeps its metrics. Everything else on the page stays still.
              -->
              <Grid VerticalAlignment="Center">
                <Border x:Name="PrimaryStatusHalo"
                        Classes="nut-status-halo"
                        Classes.healthy="{Binding IsStatusHealthy}"
                        Classes.warning="{Binding IsStatusWarning}"
                        Classes.critical="{Binding IsStatusCritical}"
                        Opacity="0"
                        IsHitTestVisible="False" />
                <!--
                  The token gets the power source drawn beside it: a plug on mains, a battery when
                  the UPS is carrying the load. The token alone is two letters of NUT jargon, and
                  the one thing anyone wants from this badge at a glance is which of the two it is.

                  Neither icon shows for a state that is neither — bypass, output off, a token NUT
                  does not define — so the badge never claims a power source the UPS did not report.
                  The pill then simply sizes to the text, which is why it is not a fixed width.
                -->
                <Border Classes="nut-pill"
                        Classes.healthy="{Binding IsStatusHealthy}"
                        Classes.warning="{Binding IsStatusWarning}"
                        Classes.critical="{Binding IsStatusCritical}"
                        Padding="21,11"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Panel Width="23" Height="23" VerticalAlignment="Center"
                           IsVisible="{Binding IsRunningOnMains}">
                      <PathIcon Data="{DynamicResource NutIconOutput}" Width="23" Height="23" />
                    </Panel>
                    <Panel Width="23" Height="23" VerticalAlignment="Center"
                           IsVisible="{Binding IsRunningOnBattery}">
                      <PathIcon Data="{DynamicResource NutIconBattery}" Width="23" Height="23" />
                    </Panel>
                    <TextBlock Text="{Binding PrimaryStatusToken}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding PrimaryStatusText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsPrimaryStatusUnknown}"
                           Classes.healthy="{Binding IsStatusHealthy}"
                           Classes.warning="{Binding IsStatusWarning}"
                           Classes.critical="{Binding IsStatusCritical}"
                           Classes.muted="{Binding IsStatusUnavailable}" />
                <TextBlock Text="{Binding PrimaryStatusDescription}"
                           Classes="nut-metadata"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasPrimaryStatusDescription}" />
                <TextBlock Text="{Binding Strings[Overview.NoStatus]}"
                           Classes="nut-metadata"
                           IsVisible="{Binding HasNoStatusItems}" />
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding StatusItems}" IsVisible="{Binding !HasNoStatusItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:OverviewStatusItemViewModel">
                  <Border Classes="nut-pill" Padding="9,3" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="16"
                              Height="16"
                              CornerRadius="8"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource NutTextSecondaryBrush}"
                              IsVisible="{Binding IsUnknown}">
                        <TextBlock Text="?"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding StateText}" FontSize="11.5" IsVisible="{Binding !IsUnknown}" />
                      <TextBlock Text="{Binding SeverityText}" FontSize="11.5" Classes="nut-metadata" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="nut-divider" />

            <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{DynamicResource NutIconTemperature}" Classes="muted" Width="13" Height="13" />
                  <TextBlock Text="{Binding Strings[Overview.Metric.Temperature]}" Classes="nut-metadata" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding TemperatureText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="1" Width="1" Background="{DynamicResource NutBorderSubtleBrush}" />
              <StackPanel Grid.Column="2" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{DynamicResource NutIconDriver}" Classes="muted" Width="13" Height="13" />
                  <TextBlock Text="Driver" Classes="nut-metadata" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding DriverText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DriverVersionText}" Classes="nut-metadata" IsVisible="{Binding HasDriverVersion}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="3" Width="1" Background="{DynamicResource NutBorderSubtleBrush}" />
              <StackPanel Grid.Column="4" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{DynamicResource NutIconUps}" Classes="muted" Width="13" Height="13" />
                  <TextBlock Text="{Binding Strings[Common.State]}" Classes="nut-metadata" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding UpsTypeText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="nut-card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{DynamicResource NutIconConnection}" Classes="accent" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.Connection]}" Classes="nut-card-title" VerticalAlignment="Center" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
              <PathIcon Data="{DynamicResource NutIconServer}" Classes="muted" Width="17" Height="17" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="NUT Server" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding EndpointText}" Classes="nut-metadata" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="2"
                      Classes="nut-pill"
                      Classes.healthy="{Binding IsConnected}"
                      Classes.warning="{Binding IsConnectionPending}"
                      Classes.critical="{Binding IsConnectionCritical}"
                      Padding="10,3">
                <TextBlock Text="{Binding ConnectionStateText}" FontSize="11.5" FontWeight="SemiBold" />
              </Border>
            </Grid>

            <Border Classes="nut-divider" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
              <PathIcon Data="{DynamicResource NutIconUps}" Classes="muted" Width="17" Height="17" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Strings[Overview.SelectedUps]}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding SelectedUpsText}" Classes="nut-metadata" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>

            <Border Classes="nut-divider" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
              <PathIcon Data="{DynamicResource NutIconRefresh}" Classes="muted" Width="17" Height="17" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Strings[Overview.Freshness]}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding DataFreshnessText}" Classes="nut-metadata" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ==================== Row 2: Active configuration | Administration ==================== -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="13">
        <Border Classes="nut-card" IsVisible="{Binding HasActiveConfiguration}">
          <StackPanel Spacing="13">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{DynamicResource NutIconSettings}" Classes="accent" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.ActiveConfiguration]}" Classes="nut-card-title" VerticalAlignment="Center" />
            </StackPanel>
            <!--
              Data on the left, decoration on the right. The illustration is purely decorative:
              it carries no state, is excluded from the accessibility tree, and collapses first
              when the card gets narrow so the configuration rows always stay readable.
            -->
            <Grid x:Name="ActiveConfigurationLayout"
                  ColumnDefinitions="*,*,Auto"
                  RowDefinitions="Auto"
                  ColumnSpacing="18"
                  RowSpacing="12">
              <ItemsControl x:Name="ActiveProfileRows"
                            ItemsSource="{Binding ActiveProfileRows}"
                            ItemTemplate="{StaticResource ActiveConfigurationRowTemplate}"
                            VerticalAlignment="Center" />

              <ItemsControl x:Name="ActiveConnectivityRows"
                            Grid.Column="1"
                            ItemsSource="{Binding ActiveConnectivityRows}"
                            ItemTemplate="{StaticResource ActiveConfigurationRowTemplate}"
                            VerticalAlignment="Center" />

              <Image x:Name="ActiveConfigurationIllustration"
                     Grid.Column="2"
                     Source="avares://NutManager.App/Assets/Illustrations/server-security.png"
                     Height="150"
                     Stretch="Uniform"
                     Opacity="0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     AutomationProperties.AccessibilityView="Raw"
                     AutomationProperties.IsOffscreenBehavior="Offscreen">
                <Image.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="CubicEaseOut" />
                  </Transitions>
                </Image.Transitions>
              </Image>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Navigation-only shortcuts into existing administration surfaces. -->
        <Border Grid.Column="1" Classes="nut-card" IsVisible="{Binding HasAdministrationShortcuts}">
          <StackPanel Spacing="11">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{DynamicResource NutIconAdministration}" Classes="accent" Width="18" Height="18" />
              <TextBlock Text="{Binding Strings[Overview.Administration]}" Classes="nut-card-title" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding AdministrationShortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:OverviewShortcutViewModel">
                  <Button Classes="nut-ghost"
                          Command="{Binding Command}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Padding="11,9"
                          Margin="0,0,0,3"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Grid Width="17" Height="17" VerticalAlignment="Center">
                        <PathIcon Data="{DynamicResource NutIconGeneral}" Classes="accent" Width="17" Height="17" IsVisible="{Binding IsConfiguration}" />
                        <PathIcon Data="{DynamicResource NutIconStart}" Classes="healthy" Width="17" Height="17" IsVisible="{Binding IsService}" />
                        <PathIcon Data="{DynamicResource NutIconDriver}" Classes="cyan" Width="17" Height="17" IsVisible="{Binding IsDevices}" />
                        <PathIcon Data="{DynamicResource NutIconLogs}" Classes="purple" Width="17" Height="17" IsVisible="{Binding IsDiagnostics}" />
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NutTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Classes="nut-metadata" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <PathIcon Grid.Column="2" Data="{DynamicResource NutIconChevronRight}" Classes="muted nut-icon-forward" Width="13" Height="13" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!--
        The identity card was removed from this page. Three of its four fields were blank in
        practice and the fourth, the NUT name, is already on the connection card above; Devices
        carries the full identification for anyone who needs it.
      -->
    </StackPanel>
  </ScrollViewer>
</UserControl>
