<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:NutManager.App.ViewModels"
        xmlns:controls="clr-namespace:NutManager.App.Presentation.Controls"
        x:Class="NutManager.App.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
             Title="NUT Manager"
        Icon="/Assets/Branding/NutManager.ico"
        Width="1280"
        Height="800"
        MinWidth="680"
        MinHeight="480"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Mica,Blur"
        WindowDecorations="BorderOnly"
        SizeChanged="Window_OnSizeChanged"
        KeyDown="Window_OnKeyDown">
  <!--
    The client area is extended so the product identity, connection state and window controls live
    in one integrated bar instead of a separate Windows title strip. OffScreenMargin keeps content
    inside the work area when the window is maximised.
  -->
  <!--
    The window itself is transparent and an acrylic pane sits behind everything, so the glass
    surfaces above it have something real to be glass over. Avalonia cannot blur in-page content, so
    without this the translucent cards were tinting a flat colour and the effect was invisible.

    The fallback chain matters: where the compositor offers no acrylic the hint degrades to Mica and
    then to plain blur, and the opaque tint underneath keeps the shell readable either way.
  -->
  <Panel>
    <!--
      Two backdrops, one drawn at a time. Turning transparency off swaps the acrylic for a solid
      surface rather than dimming it towards invisibility: the effect inherits whatever wallpaper
      the machine has, and on a busy or light one the page gets harder to read, so the answer has to
      be unambiguous. The opaque panel sits between the acrylic and the shell, so when it is drawn
      nothing behind the window reaches the content.
    -->
    <ExperimentalAcrylicBorder x:Name="AcrylicBackdrop"
                               IsHitTestVisible="False"
                               IsVisible="{Binding IsBackgroundTransparent}">
      <ExperimentalAcrylicBorder.Material>
        <!--
          TintOpacity was 1 and MaterialOpacity 0.62, which meant the tint covered the pane
          completely: the acrylic blurred a colour rather than the desktop, and the window read as a
          dark slab. Both are open now, so what is actually behind the window comes through blurred
          and the tint only darkens it enough to keep the surfaces above legible.

          These two are the whole background. Nothing above them changed: the cards, the sidebar and
          the file tiles keep their own alphas, which is what stops a see-through backdrop from
          taking the contrast of the text with it.
        -->
        <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                     TintColor="{DynamicResource NutAcrylicTintColor}"
                                     TintOpacity="0.25"
                                     MaterialOpacity="0.12" />
      </ExperimentalAcrylicBorder.Material>
      <!--
        The pane breathes. The swing is small and the period long — eight seconds between the two
        extremes — so it reads as depth rather than as something blinking for attention; at a faster
        rate or a wider swing it competes with the readings the page exists to show.
      -->
      <ExperimentalAcrylicBorder.Styles>
        <Style Selector="ExperimentalAcrylicBorder#AcrylicBackdrop">
          <Style.Animations>
            <Animation Duration="0:0:16" IterationCount="Infinite" Easing="SineEaseInOut">
              <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.92" /></KeyFrame>
              <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
              <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.92" /></KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
      </ExperimentalAcrylicBorder.Styles>
    </ExperimentalAcrylicBorder>

    <Border x:Name="OpaqueBackdrop"
            IsHitTestVisible="False"
            IsVisible="{Binding !IsBackgroundTransparent}"
            Background="{DynamicResource NutWindowOpaqueBrush}" />

  <Grid Margin="{Binding OffScreenMargin, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="{DynamicResource NutHeaderHeight}" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{DynamicResource NutFooterHeight}" />
    </Grid.RowDefinitions>

    <!-- ==================== Integrated title bar ==================== -->
    <Border Grid.Row="0"
            ZIndex="1"
            Classes="nut-titlebar"
            Padding="14,0,8,0"
            PointerPressed="TitleBar_OnPointerPressed"
            DoubleTapped="TitleBar_OnDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <Button x:Name="HeaderNavigationButton"
                Grid.Column="0"
                Classes="nut-icon"
                IsVisible="{Binding IsCompactLayout}"
                IsEnabled="{Binding IsBackgroundInteractionEnabled}"
                Command="{Binding ToggleNavigationCommand}"
                ToolTip.Tip="{Binding NavigationToggleName}"
                AutomationProperties.Name="{Binding NavigationToggleName}">
          <PathIcon Data="{DynamicResource NutIconMenu}" Width="18" Height="18" />
        </Button>

        <controls:NutConnectionIndicator Grid.Column="1"
                                         VerticalAlignment="Center"
                                         StatusText="{Binding ApplicationName}"
                                         StateText="{Binding ConnectionStatusText}"
                                         DetailText="{Binding ConnectionDetailText}"
                                         AccessibleText="{Binding ConnectionTooltip}"
                                         IsHealthy="{Binding IsConnectionHealthy}"
                                         IsPending="{Binding IsConnectionPending}"
                                         IsCritical="{Binding IsConnectionCritical}"
                                         IsUnavailable="{Binding IsConnectionUnavailable}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="nut-theme-toggle" IsEnabled="{Binding IsBackgroundInteractionEnabled}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="nut-theme-option"
                      Classes.selected="{Binding ShowDarkThemeAction}"
                      Click="LightThemeButton_OnClick"
                      ToolTip.Tip="{Binding Localizer[Theme.Light]}"
                      AutomationProperties.Name="{Binding Localizer[Theme.Light]}">
                <!-- One glyph: the library draws the disc and its rays together, so the whole sun
                     turns rather than the rays turning around a disc that holds still. Stretch is
                     off so it renders at its authored coordinates in the 24-unit box. -->
                <Grid Width="18" Height="18">
                  <Viewbox Width="18" Height="18">
                    <Grid Width="24" Height="24">
                      <Path Classes="nut-theme-glyph nut-sun" Stretch="None" Data="{DynamicResource NutIconSun}" />
                    </Grid>
                  </Viewbox>
                </Grid>
              </Button>
              <Button Classes="nut-theme-option moon"
                      Classes.selected="{Binding ShowLightThemeAction}"
                      Click="DarkThemeButton_OnClick"
                      ToolTip.Tip="{Binding Localizer[Theme.Dark]}"
                      AutomationProperties.Name="{Binding Localizer[Theme.Dark]}">
                <Grid Width="18" Height="18">
                  <Viewbox Width="18" Height="18">
                    <Grid Width="24" Height="24">
                      <Path Classes="nut-theme-glyph nut-moon" Stretch="None" Data="{DynamicResource NutIconMoon}" />
                    </Grid>
                  </Viewbox>
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="nut-window-button"
                  Click="MinimizeButton_OnClick"
                  ToolTip.Tip="{Binding Localizer[Shell.Minimize]}"
                  AutomationProperties.Name="{Binding Localizer[Shell.Minimize]}">
            <PathIcon Data="{DynamicResource NutIconWindowMinimize}" Width="15" Height="15" />
          </Button>
          <Button Classes="nut-window-button"
                  Click="MaximizeButton_OnClick"
                  ToolTip.Tip="{Binding Localizer[Shell.Maximize]}"
                  AutomationProperties.Name="{Binding Localizer[Shell.Maximize]}">
            <Grid Width="15" Height="15">
              <PathIcon x:Name="MaximizeGlyph" Data="{DynamicResource NutIconWindowMaximize}" Width="15" Height="15" />
              <PathIcon x:Name="RestoreGlyph" Data="{DynamicResource NutIconWindowRestore}" Width="15" Height="15" IsVisible="False" />
            </Grid>
          </Button>
          <Button Classes="nut-window-button close"
                  Click="CloseButton_OnClick"
                  ToolTip.Tip="{Binding Localizer[Shell.Close]}"
                  AutomationProperties.Name="{Binding Localizer[Shell.Close]}">
            <PathIcon Data="{DynamicResource NutIconClose}" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== Body ==================== -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0"
              Width="{Binding SidebarWidth}"
              Classes="nut-shell-sidebar"
              IsEnabled="{Binding IsBackgroundInteractionEnabled}"
              ClipToBounds="True">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12,10,12,10">
          <Button Grid.Row="0"
                  Classes="nut-icon"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding IsWideLayout}"
                  Command="{Binding ToggleNavigationCommand}"
                  ToolTip.Tip="{Binding NavigationToggleName}"
                  AutomationProperties.Name="{Binding NavigationToggleName}">
            <Grid Width="17" Height="17">
              <PathIcon Data="{DynamicResource NutIconChevronLeft}" Width="17" Height="17" IsVisible="{Binding IsSidebarExpanded}" />
              <PathIcon Data="{DynamicResource NutIconChevronRight}" Width="17" Height="17" IsVisible="{Binding IsSidebarCollapsed}" />
            </Grid>
          </Button>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:NavigationItemViewModel">
                <!-- The tooltip only carries information while the label is hidden (collapsed rail);
                     with the label visible it would repeat the text and cover the next item. -->
                <Button Classes.nut-navigation-item="True"
                        Classes.selected="{Binding IsSelected}"
                        AutomationProperties.Name="{Binding Title}"
                        ToolTip.Tip="{Binding Title}"
                        ToolTip.ServiceEnabled="{Binding $parent[Window].DataContext.IsSidebarCollapsed}"
                        Command="{Binding NavigateCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="13">
                    <controls:NutNavigationIcon Kind="{Binding Page}" />
                    <TextBlock Text="{Binding Title}"
                               IsVisible="{Binding $parent[Window].DataContext.IsSidebarExpanded}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button x:Name="ProfileQuickMenuButton"
                  Grid.Row="2"
                  Classes="nut-profile-card"
                  IsVisible="{Binding IsSidebarExpanded}"
                  Margin="0,12,0,8"
                  ToolTip.Tip="{Binding OpenProfilesText}"
                  Click="ProfileQuickMenuButton_OnClick"
                  AutomationProperties.Name="{Binding OpenProfilesText}">
            <Border Classes="nut-profile-card-surface">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Classes="nut-profile-avatar">
                  <PathIcon Data="{DynamicResource NutIconProfile}" Width="17" Height="17" Foreground="{DynamicResource NutTextSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActiveProfileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ActiveProfileModeText}" Classes="nut-metadata accent" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <PathIcon Grid.Column="2"
                          Data="{DynamicResource NutIconChevronDown}"
                          Width="14"
                          Height="14"
                          Foreground="{DynamicResource NutTextMutedBrush}"
                          VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Button>

          <!--
            A Popup on the window's overlay layer rather than a Flyout. A Flyout is an operating
            system window: it positions itself against the screen, not against this one, so with the
            app restored rather than maximised the profile list spilled onto the desktop beside it.
            Drawn in the overlay layer, it is clipped by the window that owns it.
          -->
          <Popup x:Name="ProfileQuickMenuPopup"
                 Grid.Row="2"
                 PlacementTarget="{Binding #ProfileQuickMenuButton}"
                 Placement="Top"
                 HorizontalOffset="0"
                 ShouldUseOverlayLayer="True"
                 IsLightDismissEnabled="True"
                 Opened="ProfileQuickMenuFlyout_OnOpened"
                 Closed="ProfileQuickMenuFlyout_OnClosed">
                <!--
                  Padding is narrower on the right so the scroll bar can sit further out. The gutter
                  the cards leave for the bar is taken from this padding rather than from the cards
                  themselves, which keeps them at their original width.
                -->
                <Border x:Name="ProfileQuickMenuSurface"
                        Width="{DynamicResource NutSidebarExpandedWidth}"
                        Classes.opaque="{Binding !IsBackgroundTransparent}"
                        Padding="12,12,2,12"
                        Margin="0,8,0,0"
                        Opacity="0"
                        Classes="nut-profile-flyout-surface">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                        <DoubleTransition.Easing>
                          <CubicEaseOut />
                        </DoubleTransition.Easing>
                      </DoubleTransition>
                      <ThicknessTransition Property="Margin" Duration="0:0:0.22">
                        <ThicknessTransition.Easing>
                          <CubicEaseOut />
                        </ThicknessTransition.Easing>
                      </ThicknessTransition>
                    </Transitions>
                  </Border.Transitions>
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="{Binding SavedProfilesText}" Classes="nut-card-title" Margin="8,5,8,0" />
                    <!--
                      Bounded so the flyout stays inside the sidebar it belongs to. Title, spacing
                      and the manage button sit outside this height, so the list has to stop well
                      short of the window or the surface runs past the selector below it.
                    -->
                    <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <!--
                        The cards stop short of the scroll bar instead of running under it. The bar
                        is painted over the content, so without a gutter it crossed the right edge of
                        every card. The room comes from the surface's right padding above, not from
                        the cards — narrowing them instead pushed their own contents onto extra lines.
                      -->
                      <ItemsControl ItemsSource="{Binding ManagedProfileCards}" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="viewModels:ManagedProfileCardViewModel">
                            <Button Classes="nut-profile-menu-item"
                                    Click="ProfileQuickMenuItem_OnClick"
                                    AutomationProperties.Name="{Binding Name}">
                              <Grid>
                                <StackPanel Spacing="4">
                                  <!--
                                    The header row is given a height of its own so the active profile
                                    and the inactive ones line up. The "Ativo" badge is taller than a
                                    bare name, and with the row sized to its content the name sat at a
                                    different height on the active card than on every other one — a
                                    step in the list that reads as broken alignment.
                                  -->
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="24">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="1"
                                            Classes="nut-pill healthy"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsActive}">
                                      <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{DynamicResource NutIconCheck}" Width="11" Height="11" Foreground="{DynamicResource NutHealthyBrush}" />
                                        <TextBlock Text="{Binding ActiveText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NutHealthyBrush}" />
                                      </StackPanel>
                                    </Border>
                                  </Grid>
                                  <TextBlock Text="{Binding Endpoint}"
                                             Classes="nut-metadata"
                                             TextWrapping="Wrap"
                                             MaxLines="2"
                                             ToolTip.Tip="{Binding Endpoint}" />
                                  <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="4">
                                    <Border Classes="nut-pill" Padding="6,1">
                                      <TextBlock Text="{Binding ManagementMode}" Classes="nut-metadata accent" FontSize="11" />
                                    </Border>
                                    <Border Classes="nut-pill" Padding="6,1">
                                      <TextBlock Text="{Binding AccessMode}" Classes="nut-metadata accent" FontSize="11" />
                                    </Border>
                                    <Border Classes="nut-pill" Padding="6,1" IsVisible="{Binding HasTransport}">
                                      <TextBlock Text="{Binding Transport}" Classes="nut-metadata" FontSize="11" />
                                    </Border>
                                  </WrapPanel>
                                </StackPanel>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <!--
                      The same right gutter the cards take, so the button ends where they end. The
                      surface pads only 2px on that side, and the 8px belongs to the scroll bar.
                    -->
                    <Button Grid.Row="2"
                            Margin="0,0,8,0"
                            Classes="nut-profile-manage"
                            Content="{Binding ManageProfilesText}"
                            Click="ManageProfiles_OnClick"
                            AutomationProperties.Name="{Binding ManageProfilesText}" />
                  </Grid>
                </Border>
          </Popup>

          <TextBlock Grid.Row="3"
                     Text="{Binding ApplicationVersionText}"
                     Classes="nut-metadata"
                     Margin="6,2"
                     IsVisible="{Binding IsSidebarExpanded}" />
        </Grid>
      </Border>

      <!--
        The tint and the content are separate layers on purpose. The tint stops at the row it belongs
        to, while the content reaches past it under the bars, and one border could not do both.
      -->
      <Panel Grid.Column="1">
        <Border Background="{DynamicResource NutWindowBrush}" />
        <!--
          Reaches under the title bar and the footer so a page scrolls beneath the chrome instead of
          being cut off against it. The numbers are NutHeaderHeight and NutFooterHeight negated.

          The padding here is horizontal only, and that is the whole trick: this padding sits inside
          this border, so a vertical value would push the scroll viewport back down by exactly what
          the margin lifted it and the content would never reach the bars at all. The vertical inset
          belongs inside the page's own scroll viewer, where it scrolls away with the content.

          The mask below fades content into the bars as it arrives, so the chrome reads as glass
          over the page rather than a lid on it.
        -->
        <Border Margin="0,-64,0,-30"
                Padding="{Binding ContentPadding}"
                ClipToBounds="True"
                IsEnabled="{Binding IsBackgroundInteractionEnabled}">
          <!--
            Content dissolves as it travels under the bars rather than simply disappearing behind
            them, which is what makes the chrome read as glass over the page instead of a lid on it.

            The bands are a share of the height rather than pixel counts, sized to sit roughly over
            the title bar and the footer: the mask is opaque again just below each one, so a page at
            rest is never dimmed and only content that has actually reached a bar is faded.
          -->
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="0.06" Color="#FF000000" />
              <GradientStop Offset="0.97" Color="#FF000000" />
              <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
          </Border.OpacityMask>
          <ContentControl Content="{Binding CurrentPage}" />
        </Border>

        <!--
          The edge vignette. Two overlays, one along the top of the page and one along the bottom,
          painted over it.

          They sit where content passes out of view, so the page darkens into the header and into
          the footer instead of ending at a cut. Purely visual: they take no pointer, add no layout
          and reserve no space. The sidebar and the title bar are outside this panel and keep their
          own surfaces.
        -->
        <Border Height="{DynamicResource NutContentVignetteHeight}"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Background="{DynamicResource NutContentVignetteTopBrush}" />
        <Border Height="{DynamicResource NutContentVignetteHeight}"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Background="{DynamicResource NutContentVignetteBottomBrush}" />

      </Panel>

      <controls:NutReviewDrawerHost Grid.Column="2"
                                    IsOpen="{Binding IsReviewDrawerInline}"
                                    Title="{Binding ReviewDrawerTitle}"
                                    PendingCount="{Binding ReviewDrawerPendingCount}"
                                    PendingText="{Binding ReviewDrawerPendingText}"
                                    DrawerContent="{Binding ReviewDrawerContent}"
                                    CloseCommand="{Binding CloseReviewDrawerCommand}"
                                    CloseText="{Binding ReviewDrawerCloseText}" />

      <Grid Grid.ColumnSpan="3"
            IsVisible="{Binding IsReviewDrawerOverlay}"
            KeyboardNavigation.TabNavigation="Cycle"
            ZIndex="15">
        <Border Background="{DynamicResource NutOverlayScrimBrush}" />
        <controls:NutReviewDrawerHost HorizontalAlignment="Right"
                                      IsOpen="True"
                                      Title="{Binding ReviewDrawerTitle}"
                                      PendingCount="{Binding ReviewDrawerPendingCount}"
                                      PendingText="{Binding ReviewDrawerPendingText}"
                                      DrawerContent="{Binding ReviewDrawerContent}"
                                      CloseCommand="{Binding CloseReviewDrawerCommand}"
                                      CloseText="{Binding ReviewDrawerCloseText}" />
      </Grid>

      <Grid Grid.ColumnSpan="3"
            IsVisible="{Binding IsSidebarOverlay}"
            IsEnabled="{Binding IsOverlayOpen}"
            IsHitTestVisible="{Binding IsOverlayOpen}"
            Opacity="{Binding NavigationOverlayOpacity}"
            KeyboardNavigation.TabNavigation="Cycle"
            ZIndex="20">
        <Grid.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          </Transitions>
        </Grid.Transitions>
        <Border Background="{DynamicResource NutOverlayScrimBrush}" PointerPressed="NavigationOverlayScrim_OnPointerPressed" />
        <Border Width="288"
                HorizontalAlignment="Left"
                Classes="nut-shell-sidebar"
                Margin="{Binding NavigationOverlayMargin}"
                Padding="14">
          <Border.Transitions>
            <Transitions>
              <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
          </Border.Transitions>
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Button x:Name="OverlayCloseButton"
                    Classes="nut-icon"
                    HorizontalAlignment="Right"
                    Command="{Binding ToggleNavigationCommand}"
                    ToolTip.Tip="{Binding NavigationToggleName}"
                    AutomationProperties.Name="{Binding NavigationToggleName}">
              <PathIcon Data="{DynamicResource NutIconChevronLeft}" Width="17" Height="17" />
            </Button>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:NavigationItemViewModel">
                  <Button Classes.nut-navigation-item="True"
                          Classes.selected="{Binding IsSelected}"
                          AutomationProperties.Name="{Binding Title}"
                          ToolTip.Tip="{Binding Title}"
                          Command="{Binding NavigateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="13">
                      <controls:NutNavigationIcon Kind="{Binding Page}" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ==================== Footer ==================== -->
    <Border Grid.Row="2" ZIndex="1" Classes="nut-footer" Padding="16,0">
      <Grid>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <PathIcon Data="{DynamicResource NutIconShield}" Width="13" Height="13" Foreground="{DynamicResource NutHealthyBrush}" />
          <TextBlock Text="{Binding AdministrationConfirmationText}" Classes="nut-metadata" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding FooterAuthorshipText}"
                   Classes="nut-metadata"
                   Foreground="{DynamicResource NutTextMutedBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsFooterAuthorshipVisible}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource NutHealthyBrush}" IsVisible="{Binding IsConnectionHealthy}" />
          <Ellipse Width="7" Height="7" Fill="{DynamicResource NutWarningBrush}" IsVisible="{Binding IsConnectionPending}" />
          <Ellipse Width="7" Height="7" Fill="{DynamicResource NutCriticalBrush}" IsVisible="{Binding IsConnectionCritical}" />
          <Ellipse Width="7" Height="7" Fill="{DynamicResource NutUnavailableBrush}" IsVisible="{Binding IsConnectionUnavailable}" />
          <TextBlock Text="{Binding ConnectionStatusText}" Classes="nut-metadata" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </Panel>
</Window>
